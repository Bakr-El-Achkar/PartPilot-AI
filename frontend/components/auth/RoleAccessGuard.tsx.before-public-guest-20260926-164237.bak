"use client";

import {
  useEffect,
  useState,
  type ReactNode,
} from "react";

import {
  usePathname,
  useRouter,
} from "next/navigation";

import {
  ApiError,
  getCurrentUser,
} from "@/lib/api";

import {
  getAccessToken,
  removeAccessToken,
} from "@/lib/auth";


type SessionRole =
  | "checking"
  | "guest"
  | "customer"
  | "admin"
  | "error";


export default function RoleAccessGuard({
  children,
}: {
  children:
    ReactNode;
}) {
  const pathname =
    usePathname();

  const router =
    useRouter();


  const [
    role,
    setRole,
  ] =
    useState<SessionRole>(
      "checking",
    );


  useEffect(() => {
    let cancelled =
      false;


    const timer =
      window.setTimeout(
        () => {
          async function verifyRole() {
            const token =
              getAccessToken();


            if (!token) {
              if (
                !cancelled
              ) {
                setRole(
                  "guest",
                );


                if (
                  pathname ===
                    "/admin" ||
                  pathname.startsWith(
                    "/admin/",
                  )
                ) {
                  router.replace(
                    "/login",
                  );
                }
              }


              return;
            }


            try {
              const currentUser =
                await getCurrentUser(
                  token,
                );


              if (
                cancelled
              ) {
                return;
              }


              const nextRole:
                SessionRole =
                  currentUser.role ===
                  "admin"
                    ? "admin"
                    : "customer";


              setRole(
                nextRole,
              );


              const isAdminRoute =
                pathname ===
                  "/admin" ||
                pathname.startsWith(
                  "/admin/",
                );


              if (
                nextRole ===
                  "admin" &&
                !isAdminRoute
              ) {
                router.replace(
                  "/admin",
                );

                return;
              }


              if (
                nextRole ===
                  "customer" &&
                isAdminRoute
              ) {
                router.replace(
                  "/account",
                );
              }

            } catch (
              error
            ) {
              if (
                cancelled
              ) {
                return;
              }


              if (
                error instanceof
                  ApiError &&
                (
                  error.status ===
                    401 ||
                  error.status ===
                    403
                )
              ) {
                removeAccessToken();

                setRole(
                  "guest",
                );


                if (
                  pathname ===
                    "/admin" ||
                  pathname.startsWith(
                    "/admin/",
                  )
                ) {
                  router.replace(
                    "/login",
                  );
                }


                return;
              }


              /*
               * Fail closed when a token exists but
               * its role cannot be verified.
               *
               * This prevents an admin session from
               * accidentally rendering customer UI.
               */
              setRole(
                "error",
              );
            }
          }


          void verifyRole();
        },
        0,
      );


    return () => {
      cancelled =
        true;

      window.clearTimeout(
        timer,
      );
    };
  }, [
    pathname,
    router,
  ]);


  const isAdminRoute =
    pathname ===
      "/admin" ||
    pathname.startsWith(
      "/admin/",
    );


  /*
   * Initial authentication check.
   * Do not render the destination page until
   * the user's role is known.
   */
  if (
    role ===
    "checking"
  ) {
    return (
      <RoleLoadingScreen />
    );
  }


  /*
   * An authenticated admin may ONLY render /admin...
   */
  if (
    role ===
      "admin" &&
    !isAdminRoute
  ) {
    return (
      <RoleLoadingScreen />
    );
  }


  /*
   * A customer may never render the Admin Console.
   */
  if (
    role ===
      "customer" &&
    isAdminRoute
  ) {
    return (
      <RoleLoadingScreen />
    );
  }


  /*
   * Guests cannot render the Admin Console.
   */
  if (
    role ===
      "guest" &&
    isAdminRoute
  ) {
    return (
      <RoleLoadingScreen />
    );
  }


  if (
    role ===
    "error"
  ) {
    return (
      <main className="flex min-h-screen items-center justify-center bg-[#f5f7fa] px-5 text-[#101828]">
        <div className="w-full max-w-[430px] rounded-[14px] border border-[#dfe3e8] bg-white p-7 text-center">
          <div className="mx-auto flex h-11 w-11 items-center justify-center rounded-[9px] bg-[#071523] text-[17px] font-black italic text-white">
            V
          </div>

          <h1 className="mt-5 text-[17px] font-bold">
            Unable to verify your account
          </h1>

          <p className="mt-2 text-[10px] leading-5 text-[#667085]">
            Vehnexa could not verify your account role. Refresh the page and try again.
          </p>

          <button
            type="button"
            onClick={() => {
              window.location.reload();
            }}
            className="mt-5 h-10 rounded-[7px] bg-[#071523] px-5 text-[9px] font-semibold text-white"
          >
            Try again
          </button>
        </div>
      </main>
    );
  }


  return (
    <>
      {
        children
      }
    </>
  );
}


function RoleLoadingScreen() {
  return (
    <main className="flex min-h-screen items-center justify-center bg-[#f5f7fa]">
      <div className="flex flex-col items-center">
        <div className="flex h-11 w-11 items-center justify-center rounded-[9px] bg-[#071523] text-[17px] font-black italic text-white">
          V
        </div>

        <p className="mt-4 text-[9px] font-semibold uppercase tracking-[0.14em] text-[#667085]">
          Loading Vehnexa
        </p>
      </div>
    </main>
  );
}
