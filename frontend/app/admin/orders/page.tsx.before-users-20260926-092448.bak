"use client";

import Link from "next/link";

import {
  useEffect,
  useMemo,
  useState,
} from "react";

import {
  useRouter,
} from "next/navigation";

import {
  Bell,
  Bot,
  CarFront,
  ExternalLink,
  LayoutDashboard,
  Package,
  Search,
  Shapes,
  ShoppingBag,
  Star,
  Tags,
  Users,
  X,
  type LucideIcon,
} from "lucide-react";

import {
  ApiError,
  getCurrentUser,
  type UserPublic,
} from "@/lib/api";

import {
  getAccessToken,
  removeAccessToken,
} from "@/lib/auth";

import {
  getAdminOrders,
  updateAdminOrderStatus,
  type AdminOrder,
  type AdminOrderStatus,
} from "@/lib/admin";


const STATUS_LABELS: Record<
  AdminOrderStatus,
  string
> = {
  processing:
    "Processing",

  shipped:
    "Shipped",

  delivered:
    "Delivered",

  cancelled:
    "Cancelled",
};


const STATUS_TRANSITIONS: Record<
  AdminOrderStatus,
  AdminOrderStatus[]
> = {
  processing: [
    "processing",
    "shipped",
    "delivered",
    "cancelled",
  ],

  shipped: [
    "shipped",
    "delivered",
  ],

  delivered: [
    "delivered",
  ],

  cancelled: [
    "cancelled",
  ],
};


export default function AdminOrdersPage() {
  const router =
    useRouter();


  const [
    user,
    setUser,
  ] =
    useState<UserPublic | null>(
      null,
    );


  const [
    orders,
    setOrders,
  ] =
    useState<AdminOrder[]>(
      [],
    );


  const [
    selectedOrder,
    setSelectedOrder,
  ] =
    useState<AdminOrder | null>(
      null,
    );


  const [
    loading,
    setLoading,
  ] =
    useState(
      true,
    );


  const [
    error,
    setError,
  ] =
    useState(
      "",
    );


  const [
    updating,
    setUpdating,
  ] =
    useState(
      false,
    );


  const [
    search,
    setSearch,
  ] =
    useState(
      "",
    );


  const [
    filterStatus,
    setFilterStatus,
  ] =
    useState<
      AdminOrderStatus | "all"
    >(
      "all",
    );


  useEffect(() => {
    const token =
      getAccessToken();


    if (!token) {
      router.replace(
        "/login",
      );

      return;
    }


    const accessToken =
      token;


    let cancelled =
      false;


    async function load() {
      try {
        const currentUser =
          await getCurrentUser(
            accessToken,
          );


        if (
          cancelled
        ) {
          return;
        }


        if (
          currentUser.role !==
          "admin"
        ) {
          router.replace(
            "/",
          );

          return;
        }


        setUser(
          currentUser,
        );


        const result =
          await getAdminOrders(
            accessToken,
          );


        if (
          cancelled
        ) {
          return;
        }


        setOrders(
          result,
        );

      } catch (
        loadError
      ) {
        if (
          loadError instanceof
            ApiError &&
          loadError.status ===
            401
        ) {
          removeAccessToken();

          router.replace(
            "/login",
          );

          return;
        }


        if (
          loadError instanceof
            ApiError &&
          loadError.status ===
            403
        ) {
          router.replace(
            "/",
          );

          return;
        }


        if (
          !cancelled
        ) {
          setError(
            loadError instanceof
              Error
              ? loadError.message
              : "Unable to load orders.",
          );
        }

      } finally {
        if (
          !cancelled
        ) {
          setLoading(
            false,
          );
        }
      }
    }


    void load();


    return () => {
      cancelled =
        true;
    };
  }, [
    router,
  ]);


  const visibleOrders =
    useMemo(
      () => {
        const needle =
          search
            .trim()
            .toLowerCase();


        return orders.filter(
          (
            order,
          ) => {
            if (
              filterStatus !==
                "all" &&
              order.status !==
                filterStatus
            ) {
              return false;
            }


            if (!needle) {
              return true;
            }


            return [
              order.order_number,
              order.customer_name,
              order.customer_email,
              order.shipping_address,
            ].some(
              (
                value,
              ) =>
                value
                  .toLowerCase()
                  .includes(
                    needle,
                  ),
            );
          },
        );
      },
      [
        orders,
        search,
        filterStatus,
      ],
    );


  async function changeStatus(
    newStatus:
      AdminOrderStatus,
  ) {
    if (
      !selectedOrder ||
      updating ||
      newStatus ===
        selectedOrder.status
    ) {
      return;
    }


    const token =
      getAccessToken();


    if (!token) {
      router.replace(
        "/login",
      );

      return;
    }


    if (
      newStatus ===
      "cancelled"
    ) {
      const confirmed =
        window.confirm(
          "Cancel this order? Reserved product stock will be returned to inventory.",
        );


      if (!confirmed) {
        return;
      }
    }


    try {
      setUpdating(
        true,
      );

      setError(
        "",
      );


      const updated =
        await updateAdminOrderStatus(
          token,
          selectedOrder.id,
          newStatus,
        );


      setSelectedOrder(
        updated,
      );


      setOrders(
        (
          current,
        ) =>
          current.map(
            (
              order,
            ) =>
              order.id ===
              updated.id
                ? updated
                : order,
          ),
      );

    } catch (
      updateError
    ) {
      if (
        updateError instanceof
          ApiError &&
        updateError.status ===
          401
      ) {
        removeAccessToken();

        router.replace(
          "/login",
        );

        return;
      }


      setError(
        updateError instanceof
          Error
          ? updateError.message
          : "Unable to update order status.",
      );

    } finally {
      setUpdating(
        false,
      );
    }
  }


  const adminName =
    user
      ? `${user.first_name} ${user.last_name}`.trim()
      : "Administrator";


  return (
    <main className="min-h-screen bg-[#f5f6f8] text-[#101828]">
      <div className="flex min-h-screen">
        <AdminSidebar />


        <section className="min-w-0 flex-1">
          <header className="flex h-[70px] items-center justify-between border-b border-[#e4e7ec] bg-white px-5 sm:px-8">
            <div>
              <p className="text-[9px] font-semibold uppercase tracking-[0.14em] text-[#98a2b3]">
                Admin Console
              </p>

              <p className="mt-1 text-[12px] font-semibold text-[#344054]">
                {
                  adminName
                }
              </p>
            </div>


            <Link
              href="/"
              className="flex items-center gap-2 rounded-[7px] border border-[#d0d5dd] bg-white px-4 py-2 text-[9px] font-semibold text-[#344054]"
            >
              <ExternalLink className="h-3.5 w-3.5" />

              Store
            </Link>
          </header>


          <div className="mx-auto max-w-[1400px] p-5 sm:p-8">
            <div className="flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between">
              <div>
                <h1 className="text-[28px] font-bold tracking-[-0.035em]">
                  Orders
                </h1>

                <p className="mt-2 text-[11px] text-[#667085]">
                  Review customer orders and manage fulfillment status.
                </p>
              </div>


              <div className="flex flex-col gap-2 sm:flex-row">
                <div className="relative">
                  <Search className="absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[#98a2b3]" />

                  <input
                    value={
                      search
                    }
                    onChange={
                      (
                        event,
                      ) =>
                        setSearch(
                          event.target.value,
                        )
                    }
                    placeholder="Search orders..."
                    className="h-10 w-full rounded-[7px] border border-[#d0d5dd] bg-white pl-9 pr-3 text-[10px] outline-none focus:border-[#98a2b3] sm:w-[250px]"
                  />
                </div>


                <select
                  value={
                    filterStatus
                  }
                  onChange={
                    (
                      event,
                    ) =>
                      setFilterStatus(
                        event.target.value as
                          | AdminOrderStatus
                          | "all",
                      )
                  }
                  className="h-10 rounded-[7px] border border-[#d0d5dd] bg-white px-3 text-[10px] font-medium outline-none"
                >
                  <option value="all">
                    All statuses
                  </option>

                  <option value="processing">
                    Processing
                  </option>

                  <option value="shipped">
                    Shipped
                  </option>

                  <option value="delivered">
                    Delivered
                  </option>

                  <option value="cancelled">
                    Cancelled
                  </option>
                </select>
              </div>
            </div>


            {error && (
              <div className="mt-5 rounded-[8px] border border-[#f1c7cc] bg-[#fff4f5] px-4 py-3 text-[10px] text-[#b4232f]">
                {
                  error
                }
              </div>
            )}


            <div className="mt-7 rounded-[14px] border border-[#dfe3e8] bg-white">
              {loading ? (
                <div className="space-y-3 p-5">
                  {[
                    1,
                    2,
                    3,
                    4,
                  ].map(
                    (
                      item,
                    ) => (
                      <div
                        key={
                          item
                        }
                        className="h-[70px] animate-pulse rounded-[8px] bg-[#f2f4f7]"
                      />
                    ),
                  )}
                </div>
              ) : visibleOrders.length ===
                0 ? (
                <div className="px-6 py-16 text-center">
                  <ShoppingBag className="mx-auto h-8 w-8 text-[#98a2b3]" />

                  <p className="mt-4 text-[12px] font-semibold">
                    No orders found
                  </p>

                  <p className="mt-1 text-[9px] text-[#667085]">
                    There are no orders matching the current filters.
                  </p>
                </div>
              ) : (
                <div className="overflow-x-auto">
                  <table className="w-full min-w-[900px] border-collapse">
                    <thead>
                      <tr className="border-b border-[#eaecf0] bg-[#fafbfc] text-left">
                        <TableHeading>
                          Order
                        </TableHeading>

                        <TableHeading>
                          Customer
                        </TableHeading>

                        <TableHeading>
                          Date
                        </TableHeading>

                        <TableHeading>
                          Items
                        </TableHeading>

                        <TableHeading>
                          Total
                        </TableHeading>

                        <TableHeading>
                          Payment
                        </TableHeading>

                        <TableHeading>
                          Status
                        </TableHeading>

                        <TableHeading>
                          Action
                        </TableHeading>
                      </tr>
                    </thead>


                    <tbody>
                      {visibleOrders.map(
                        (
                          order,
                        ) => (
                          <tr
                            key={
                              order.id
                            }
                            className="border-b border-[#eaecf0] last:border-0 hover:bg-[#fafbfc]"
                          >
                            <TableCell>
                              <p className="font-semibold text-[#101828]">
                                {
                                  order.order_number
                                }
                              </p>
                            </TableCell>


                            <TableCell>
                              <p className="font-semibold text-[#344054]">
                                {
                                  order.customer_name
                                }
                              </p>

                              <p className="mt-1 text-[8px] text-[#98a2b3]">
                                {
                                  order.customer_email ||
                                  "No email"
                                }
                              </p>
                            </TableCell>


                            <TableCell>
                              {
                                formatDate(
                                  order.created_at,
                                )
                              }
                            </TableCell>


                            <TableCell>
                              {
                                order.items.reduce(
                                  (
                                    total,
                                    item,
                                  ) =>
                                    total +
                                    item.quantity,
                                  0,
                                )
                              }
                            </TableCell>


                            <TableCell>
                              <span className="font-semibold text-[#101828]">
                                {
                                  formatMoney(
                                    order.total,
                                  )
                                }
                              </span>
                            </TableCell>


                            <TableCell>
                              <div>
                                <p className="capitalize">
                                  {
                                    order.payment_method
                                      .replaceAll(
                                        "_",
                                        " ",
                                      )
                                  }
                                </p>

                                <p className="mt-1 capitalize text-[8px] text-[#98a2b3]">
                                  {
                                    order.payment_status
                                  }
                                </p>
                              </div>
                            </TableCell>


                            <TableCell>
                              <StatusBadge
                                status={
                                  order.status
                                }
                              />
                            </TableCell>


                            <TableCell>
                              <button
                                type="button"
                                onClick={() =>
                                  setSelectedOrder(
                                    order,
                                  )
                                }
                                className="rounded-[6px] border border-[#d0d5dd] px-3 py-2 text-[9px] font-semibold text-[#344054] transition hover:border-[#98a2b3]"
                              >
                                View
                              </button>
                            </TableCell>
                          </tr>
                        ),
                      )}
                    </tbody>
                  </table>
                </div>
              )}
            </div>


            {!loading && (
              <p className="mt-3 text-[9px] text-[#98a2b3]">
                Showing{" "}
                {
                  visibleOrders.length
                }{" "}
                of{" "}
                {
                  orders.length
                }{" "}
                orders
              </p>
            )}
          </div>
        </section>
      </div>


      {selectedOrder && (
        <OrderDrawer
          order={
            selectedOrder
          }
          updating={
            updating
          }
          onClose={() =>
            setSelectedOrder(
              null,
            )
          }
          onStatusChange={
            changeStatus
          }
        />
      )}
    </main>
  );
}


function AdminSidebar() {
  return (
    <aside className="hidden w-[230px] shrink-0 bg-[#071523] text-white lg:flex lg:flex-col">
      <div className="border-b border-white/10 px-6 py-6">
        <Link
          href="/admin"
          className="flex items-center gap-3"
        >
          <div className="flex h-9 w-9 items-center justify-center rounded-[7px] bg-[#ef3d43] text-[18px] font-black italic text-white">
            V
          </div>

          <div>
            <div className="text-[14px] font-bold tracking-wide">
              VEHNEXA
            </div>

            <div className="mt-0.5 text-[8px] font-semibold tracking-[0.18em] text-[#98a2b3]">
              ADMIN CONSOLE
            </div>
          </div>
        </Link>
      </div>


      <nav className="flex-1 space-y-1 px-3 py-5">
        <AdminNavItem
          href="/admin"
          icon={
            LayoutDashboard
          }
          label="Overview"
        />

        <AdminNavItem
          href="/admin/products"
          icon={
            Package
          }
          label="Products"
        />

        <AdminNavItem
          href="/admin/categories"
          icon={
            Shapes
          }
          label="Categories"
        />

        <AdminNavItem
          href="/admin/brands"
          icon={
            Tags
          }
          label="Brands"
        />

        <AdminNavItem
          href="/admin/fitments"
          icon={
            CarFront
          }
          label="Fitments"
        />

        <AdminNavItem
          href="/admin/orders"
          icon={
            ShoppingBag
          }
          label="Orders"
          active
        />

        <AdminNavItem
          icon={
            Users
          }
          label="Users"
        />

        <AdminNavItem
          icon={
            Star
          }
          label="Reviews"
        />

        <AdminNavItem
          icon={
            Bot
          }
          label="AI Sessions"
        />

        <AdminNavItem
          icon={
            Bell
          }
          label="Notifications"
        />
      </nav>


      <div className="border-t border-white/10 p-4">
        <Link
          href="/"
          className="flex h-10 items-center justify-center gap-2 rounded-[7px] border border-white/15 text-[9px] font-semibold text-[#d0d5dd] transition hover:bg-white/5"
        >
          <ExternalLink className="h-3.5 w-3.5" />

          View storefront
        </Link>
      </div>
    </aside>
  );
}


function OrderDrawer({
  order,
  updating,
  onClose,
  onStatusChange,
}: {
  order:
    AdminOrder;

  updating:
    boolean;

  onClose:
    () => void;

  onStatusChange:
    (
      status:
        AdminOrderStatus,
    ) => void;
}) {
  const allowed =
    STATUS_TRANSITIONS[
      order.status
    ];


  return (
    <div className="fixed inset-0 z-50 flex justify-end bg-black/30">
      <button
        type="button"
        aria-label="Close order details"
        onClick={
          onClose
        }
        className="absolute inset-0"
      />


      <aside className="relative z-10 h-full w-full max-w-[520px] overflow-y-auto bg-white shadow-2xl">
        <div className="flex items-start justify-between border-b border-[#eaecf0] px-6 py-5">
          <div>
            <p className="text-[8px] font-semibold uppercase tracking-[0.12em] text-[#98a2b3]">
              Order details
            </p>

            <h2 className="mt-1 text-[20px] font-bold">
              {
                order.order_number
              }
            </h2>

            <p className="mt-1 text-[9px] text-[#667085]">
              {
                formatDateTime(
                  order.created_at,
                )
              }
            </p>
          </div>


          <button
            type="button"
            onClick={
              onClose
            }
            className="flex h-9 w-9 items-center justify-center rounded-[7px] border border-[#eaecf0]"
          >
            <X className="h-4 w-4" />
          </button>
        </div>


        <div className="space-y-6 p-6">
          <section>
            <SectionTitle>
              Fulfillment status
            </SectionTitle>

            <div className="mt-3 flex items-center gap-3">
              <StatusBadge
                status={
                  order.status
                }
              />

              <select
                value={
                  order.status
                }
                disabled={
                  updating ||
                  allowed.length ===
                    1
                }
                onChange={
                  (
                    event,
                  ) =>
                    onStatusChange(
                      event.target.value as
                        AdminOrderStatus,
                    )
                }
                className="h-10 flex-1 rounded-[7px] border border-[#d0d5dd] bg-white px-3 text-[10px] font-semibold outline-none disabled:bg-[#f2f4f7] disabled:text-[#98a2b3]"
              >
                {allowed.map(
                  (
                    status,
                  ) => (
                    <option
                      key={
                        status
                      }
                      value={
                        status
                      }
                    >
                      {
                        STATUS_LABELS[
                          status
                        ]
                      }
                    </option>
                  ),
                )}
              </select>
            </div>


            {updating && (
              <p className="mt-2 text-[9px] text-[#667085]">
                Updating order status...
              </p>
            )}
          </section>


          <section>
            <SectionTitle>
              Customer
            </SectionTitle>

            <div className="mt-3 rounded-[9px] border border-[#eaecf0] p-4">
              <p className="text-[11px] font-semibold">
                {
                  order.customer_name
                }
              </p>

              <p className="mt-1 text-[9px] text-[#667085]">
                {
                  order.customer_email ||
                  "No email available"
                }
              </p>

              {order.customer_phone && (
                <p className="mt-1 text-[9px] text-[#667085]">
                  {
                    order.customer_phone
                  }
                </p>
              )}
            </div>
          </section>


          <section>
            <SectionTitle>
              Items
            </SectionTitle>

            <div className="mt-3 space-y-3">
              {order.items.map(
                (
                  item,
                ) => (
                  <div
                    key={
                      item.product_id
                    }
                    className="flex items-center justify-between gap-4 rounded-[9px] border border-[#eaecf0] p-4"
                  >
                    <div className="min-w-0">
                      <p className="truncate text-[10px] font-semibold">
                        {
                          item.name
                        }
                      </p>

                      <p className="mt-1 text-[8px] text-[#98a2b3]">
                        SKU{" "}
                        {
                          item.sku
                        }{" "}
                        · Qty{" "}
                        {
                          item.quantity
                        }{" "}
                        ·{" "}
                        {
                          formatMoney(
                            item.unit_price,
                          )
                        }
                      </p>
                    </div>


                    <p className="shrink-0 text-[10px] font-bold">
                      {
                        formatMoney(
                          item.line_total,
                        )
                      }
                    </p>
                  </div>
                ),
              )}
            </div>
          </section>


          <section>
            <SectionTitle>
              Shipping
            </SectionTitle>

            <div className="mt-3 whitespace-pre-line rounded-[9px] border border-[#eaecf0] p-4 text-[9px] leading-5 text-[#475467]">
              {
                order.shipping_address
              }
            </div>
          </section>


          <section>
            <SectionTitle>
              Payment
            </SectionTitle>

            <div className="mt-3 grid grid-cols-2 gap-3">
              <InfoBox
                label="Method"
                value={
                  order.payment_method
                    .replaceAll(
                      "_",
                      " ",
                    )
                }
              />

              <InfoBox
                label="Status"
                value={
                  order.payment_status
                }
              />
            </div>
          </section>


          <section>
            <SectionTitle>
              Order total
            </SectionTitle>

            <div className="mt-3 rounded-[9px] border border-[#eaecf0] p-4">
              <MoneyRow
                label="Subtotal"
                value={
                  order.subtotal
                }
              />

              <MoneyRow
                label="Delivery"
                value={
                  order.delivery_fee
                }
              />

              <MoneyRow
                label="Discount"
                value={
                  -order.discount
                }
              />

              <div className="my-3 border-t border-[#eaecf0]" />

              <div className="flex items-center justify-between">
                <span className="text-[10px] font-bold">
                  Total
                </span>

                <span className="text-[15px] font-bold">
                  {
                    formatMoney(
                      order.total,
                    )
                  }
                </span>
              </div>
            </div>
          </section>
        </div>
      </aside>
    </div>
  );
}


function TableHeading({
  children,
}: {
  children:
    React.ReactNode;
}) {
  return (
    <th className="px-5 py-3 text-[8px] font-semibold uppercase tracking-[0.1em] text-[#98a2b3]">
      {
        children
      }
    </th>
  );
}


function TableCell({
  children,
}: {
  children:
    React.ReactNode;
}) {
  return (
    <td className="px-5 py-4 text-[9px] text-[#475467]">
      {
        children
      }
    </td>
  );
}


function StatusBadge({
  status,
}: {
  status:
    AdminOrderStatus;
}) {
  const classes: Record<
    AdminOrderStatus,
    string
  > = {
    processing:
      "border-[#fedf89] bg-[#fffaeb] text-[#b54708]",

    shipped:
      "border-[#b2ddff] bg-[#eff8ff] text-[#175cd3]",

    delivered:
      "border-[#abefc6] bg-[#ecfdf3] text-[#067647]",

    cancelled:
      "border-[#fecdca] bg-[#fef3f2] text-[#b42318]",
  };


  return (
    <span
      className={`inline-flex rounded-full border px-2.5 py-1 text-[8px] font-semibold ${classes[status]}`}
    >
      {
        STATUS_LABELS[
          status
        ]
      }
    </span>
  );
}


function SectionTitle({
  children,
}: {
  children:
    React.ReactNode;
}) {
  return (
    <h3 className="text-[9px] font-semibold uppercase tracking-[0.1em] text-[#667085]">
      {
        children
      }
    </h3>
  );
}


function InfoBox({
  label,
  value,
}: {
  label:
    string;

  value:
    string;
}) {
  return (
    <div className="rounded-[9px] border border-[#eaecf0] p-4">
      <p className="text-[8px] font-semibold uppercase tracking-[0.1em] text-[#98a2b3]">
        {
          label
        }
      </p>

      <p className="mt-2 text-[10px] font-semibold capitalize">
        {
          value
        }
      </p>
    </div>
  );
}


function MoneyRow({
  label,
  value,
}: {
  label:
    string;

  value:
    number;
}) {
  return (
    <div className="mb-2 flex items-center justify-between text-[9px] text-[#667085] last:mb-0">
      <span>
        {
          label
        }
      </span>

      <span className="font-medium text-[#344054]">
        {
          formatMoney(
            value,
          )
        }
      </span>
    </div>
  );
}


function AdminNavItem({
  href,
  icon:
    Icon,
  label,
  active =
    false,
}: {
  href?:
    string;

  icon:
    LucideIcon;

  label:
    string;

  active?:
    boolean;
}) {
  const className =
    active
      ? "flex h-10 items-center gap-3 rounded-[7px] bg-white/10 px-3 text-[9px] font-semibold text-white"
      : "flex h-10 items-center gap-3 rounded-[7px] px-3 text-[9px] font-medium text-[#98a2b3] transition hover:bg-white/5 hover:text-white";


  const content = (
    <>
      <Icon className="h-4 w-4" />

      {
        label
      }
    </>
  );


  if (href) {
    return (
      <Link
        href={
          href
        }
        className={
          className
        }
      >
        {
          content
        }
      </Link>
    );
  }


  return (
    <div
      className={
        className
      }
    >
      {
        content
      }
    </div>
  );
}


function formatMoney(
  value: number,
) {
  return new Intl.NumberFormat(
    "en-US",
    {
      style:
        "currency",

      currency:
        "USD",

      maximumFractionDigits:
        2,
    },
  ).format(
    value,
  );
}


function formatDate(
  value: string,
) {
  return new Intl.DateTimeFormat(
    "en-US",
    {
      month:
        "short",

      day:
        "2-digit",

      year:
        "numeric",
    },
  ).format(
    new Date(
      value,
    ),
  );
}


function formatDateTime(
  value: string,
) {
  return new Intl.DateTimeFormat(
    "en-US",
    {
      month:
        "short",

      day:
        "2-digit",

      year:
        "numeric",

      hour:
        "2-digit",

      minute:
        "2-digit",
    },
  ).format(
    new Date(
      value,
    ),
  );
}
