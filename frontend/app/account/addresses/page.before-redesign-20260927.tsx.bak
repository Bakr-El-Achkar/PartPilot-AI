"use client";

import CustomerLogoutButton from "@/components/customer/CustomerLogoutButton";
import NavbarNotificationBell from "@/components/notifications/NavbarNotificationBell";

import Link from "next/link";

import {
  type FormEvent,
  useEffect,
  useMemo,
  useState,
} from "react";

import {
  useRouter,
} from "next/navigation";

import {
  AnimatePresence,
  motion,
  useReducedMotion,
} from "framer-motion";

import {
  ArrowRight,
  BadgeCheck,
  Bell,
  Check,
  CheckCircle2,
  Edit3,
  Heart,
  Home,
  LayoutDashboard,
  Loader2,
  MapPin,
  Navigation,
  Package,
  Phone,
  Plus,
  Search,
  ShieldCheck,
  ShoppingCart,
  Sparkles,
  Star,
  Trash2,
  UserRound,
  X,
  type LucideIcon,
} from "lucide-react";

import {
  ApiError,
  getCurrentUser,
  type UserPublic,
} from "@/lib/api";

import {
  getAccessToken,
  removeAccessToken,
} from "@/lib/auth";

import {
  createAddress,
  deleteAddress,
  getAddresses,
  setDefaultAddress,
  updateAddress,
  type Address,
  type AddressPayload,
} from "@/lib/addresses";

import {
  CART_UPDATED_EVENT,
  getCartCount,
} from "@/lib/cart";


type AddressFormState = {
  label: string;

  recipient_name: string;
  phone: string;

  address_line1: string;
  address_line2: string;

  city: string;
  region: string;

  country: string;
  postal_code: string;
};


const EMPTY_FORM:
  AddressFormState = {
    label:
      "Home",

    recipient_name:
      "",

    phone:
      "",

    address_line1:
      "",

    address_line2:
      "",

    city:
      "",

    region:
      "",

    country:
      "Lebanon",

    postal_code:
      "",
  };


/* ============================================================
   SAVED ADDRESSES
============================================================ */

export default function SavedAddressesPage() {
  const router =
    useRouter();


  const reduceMotion =
    useReducedMotion();


  const [
    user,
    setUser,
  ] =
    useState<UserPublic | null>(
      null,
    );


  const [
    addresses,
    setAddresses,
  ] =
    useState<Address[]>(
      [],
    );


  const [
    loading,
    setLoading,
  ] =
    useState(
      true,
    );


  const [
    saving,
    setSaving,
  ] =
    useState(
      false,
    );


  const [
    error,
    setError,
  ] =
    useState(
      "",
    );


  const [
    success,
    setSuccess,
  ] =
    useState(
      "",
    );


  const [
    formOpen,
    setFormOpen,
  ] =
    useState(
      false,
    );


  const [
    editingId,
    setEditingId,
  ] =
    useState<string | null>(
      null,
    );


  const [
    form,
    setForm,
  ] =
    useState<AddressFormState>(
      EMPTY_FORM,
    );


  const [
    cartCount,
    setCartCount,
  ] =
    useState(
      0,
    );


  /* ==========================================================
     CART
  ========================================================== */

  useEffect(() => {
    function syncCart() {
      setCartCount(
        getCartCount(),
      );
    }


    syncCart();


    window.addEventListener(
      CART_UPDATED_EVENT,
      syncCart,
    );


    return () => {
      window.removeEventListener(
        CART_UPDATED_EVENT,
        syncCart,
      );
    };
  }, []);


  /* ==========================================================
     LOAD
  ========================================================== */

  useEffect(() => {
    const token =
      getAccessToken();


    if (!token) {
      router.replace(
        "/login",
      );

      return;
    }


    const accessToken =
      token;


    let cancelled =
      false;


    async function loadPage() {
      try {
        const [
          currentUser,
          savedAddresses,
        ] =
          await Promise.all([
            getCurrentUser(
              accessToken,
            ),

            getAddresses(
              accessToken,
            ),
          ]);


        if (
          cancelled
        ) {
          return;
        }


        setUser(
          currentUser,
        );


        setAddresses(
          savedAddresses,
        );

      } catch (
        loadError
      ) {
        if (
          loadError instanceof
            ApiError &&
          (
            loadError.status ===
              401 ||
            loadError.status ===
              403
          )
        ) {
          removeAccessToken();

          router.replace(
            "/login",
          );

          return;
        }


        if (
          !cancelled
        ) {
          setError(
            loadError instanceof
              ApiError
              ? loadError.message
              : "Unable to load saved addresses.",
          );
        }

      } finally {
        if (
          !cancelled
        ) {
          setLoading(
            false,
          );
        }
      }
    }


    void loadPage();


    return () => {
      cancelled =
        true;
    };
  }, [
    router,
  ]);


  /* ==========================================================
     CUSTOMER IDENTITY
  ========================================================== */

  const displayName =
    useMemo(
      () => {
        if (!user) {
          return "Customer";
        }


        return (
          `${user.first_name ?? ""} ${user.last_name ?? ""}`
            .trim() ||
          "Customer"
        );
      },
      [
        user,
      ],
    );


  const initials =
    useMemo(
      () => {
        if (!user) {
          return "V";
        }


        const first =
          user.first_name?.[0] ??
          "";


        const last =
          user.last_name?.[0] ??
          "";


        return (
          `${first}${last}`
            .toUpperCase() ||
          "V"
        );
      },
      [
        user,
      ],
    );


  /* ==========================================================
     DERIVED DATA
  ========================================================== */

  const defaultAddress =
    useMemo(
      () =>
        addresses.find(
          (
            address,
          ) =>
            address.is_default,
        ) ??
        null,
      [
        addresses,
      ],
    );


  const sortedAddresses =
    useMemo(
      () =>
        [
          ...addresses,
        ].sort(
          (
            first,
            second,
          ) =>
            Number(
              second.is_default,
            ) -
            Number(
              first.is_default,
            ),
        ),
      [
        addresses,
      ],
    );


  const cityCount =
    useMemo(
      () =>
        new Set(
          addresses
            .map(
              (
                address,
              ) =>
                address.city
                  .trim()
                  .toLowerCase(),
            )
            .filter(
              Boolean,
            ),
        ).size,
      [
        addresses,
      ],
    );


  const countryCount =
    useMemo(
      () =>
        new Set(
          addresses
            .map(
              (
                address,
              ) =>
                address.country
                  .trim()
                  .toLowerCase(),
            )
            .filter(
              Boolean,
            ),
        ).size,
      [
        addresses,
      ],
    );


  /* ==========================================================
     FORM
  ========================================================== */

  function resetForm() {
    setForm(
      EMPTY_FORM,
    );


    setEditingId(
      null,
    );


    setFormOpen(
      false,
    );
  }


  function openNewAddress() {
    setError(
      "",
    );


    setSuccess(
      "",
    );


    setEditingId(
      null,
    );


    setForm({
      ...EMPTY_FORM,

      recipient_name:
        displayName ===
          "Customer"
          ? ""
          : displayName,

      phone:
        user?.phone ??
        "",
    });


    setFormOpen(
      true,
    );
  }


  function openEdit(
    address:
      Address,
  ) {
    setError(
      "",
    );


    setSuccess(
      "",
    );


    setEditingId(
      address.id,
    );


    setForm({
      label:
        address.label,

      recipient_name:
        address.recipient_name,

      phone:
        address.phone,

      address_line1:
        address.address_line1,

      address_line2:
        address.address_line2 ??
        "",

      city:
        address.city,

      region:
        address.region ??
        "",

      country:
        address.country,

      postal_code:
        address.postal_code ??
        "",
    });


    setFormOpen(
      true,
    );
  }


  function updateField(
    field:
      keyof AddressFormState,
    value:
      string,
  ) {
    setForm(
      (
        current,
      ) => ({
        ...current,

        [field]:
          value,
      }),
    );
  }


  /* ==========================================================
     CREATE / UPDATE
  ========================================================== */

  async function submitAddress(
    event:
      FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault();


    const token =
      getAccessToken();


    if (!token) {
      router.replace(
        "/login",
      );

      return;
    }


    const payload:
      AddressPayload = {
        label:
          form.label.trim(),

        recipient_name:
          form.recipient_name.trim(),

        phone:
          form.phone.trim(),

        address_line1:
          form.address_line1.trim(),

        address_line2:
          form.address_line2.trim() ||
          null,

        city:
          form.city.trim(),

        region:
          form.region.trim() ||
          null,

        country:
          form.country.trim(),

        postal_code:
          form.postal_code.trim() ||
          null,
      };


    try {
      setSaving(
        true,
      );


      setError(
        "",
      );


      setSuccess(
        "",
      );


      if (
        editingId
      ) {
        const updated =
          await updateAddress(
            token,
            editingId,
            payload,
          );


        setAddresses(
          (
            current,
          ) =>
            current.map(
              (
                item,
              ) =>
                item.id ===
                updated.id
                  ? updated
                  : item,
            ),
        );


        setSuccess(
          "Address updated.",
        );

      } else {
        const created =
          await createAddress(
            token,
            payload,
          );


        setAddresses(
          (
            current,
          ) => [
            created,
            ...current,
          ],
        );


        setSuccess(
          "Address saved.",
        );
      }


      resetForm();

    } catch (
      saveError
    ) {
      setError(
        saveError instanceof
          ApiError
          ? saveError.message
          : "Unable to save address.",
      );

    } finally {
      setSaving(
        false,
      );
    }
  }


  /* ==========================================================
     DEFAULT
  ========================================================== */

  async function makeDefault(
    addressId:
      string,
  ) {
    const token =
      getAccessToken();


    if (!token) {
      router.replace(
        "/login",
      );

      return;
    }


    try {
      setError(
        "",
      );


      setSuccess(
        "",
      );


      const updated =
        await setDefaultAddress(
          token,
          addressId,
        );


      setAddresses(
        (
          current,
        ) =>
          current
            .map(
              (
                item,
              ) => ({
                ...item,

                is_default:
                  item.id ===
                  updated.id,
              }),
            )
            .sort(
              (
                first,
                second,
              ) =>
                Number(
                  second.is_default,
                ) -
                Number(
                  first.is_default,
                ),
            ),
      );


      setSuccess(
        "Default address updated.",
      );

    } catch (
      defaultError
    ) {
      setError(
        defaultError instanceof
          ApiError
          ? defaultError.message
          : "Unable to update default address.",
      );
    }
  }


  /* ==========================================================
     DELETE
  ========================================================== */

  async function removeAddress(
    address:
      Address,
  ) {
    const confirmed =
      window.confirm(
        `Delete "${address.label}" address?`,
      );


    if (
      !confirmed
    ) {
      return;
    }


    const token =
      getAccessToken();


    if (!token) {
      router.replace(
        "/login",
      );

      return;
    }


    try {
      setError(
        "",
      );


      setSuccess(
        "",
      );


      await deleteAddress(
        token,
        address.id,
      );


      const refreshed =
        await getAddresses(
          token,
        );


      setAddresses(
        refreshed,
      );


      if (
        editingId ===
        address.id
      ) {
        resetForm();
      }


      setSuccess(
        "Address deleted.",
      );

    } catch (
      deleteError
    ) {
      setError(
        deleteError instanceof
          ApiError
          ? deleteError.message
          : "Unable to delete address.",
      );
    }
  }


  /* ==========================================================
     RENDER
  ========================================================== */

  return (
    <main className="min-h-screen overflow-x-hidden bg-[#f2f4f7] text-[#101828]">
      <AddressesNavbar
        cartCount={
          cartCount
        }
      />


      {/* ======================================================
          HERO
      ====================================================== */}

      <section className="relative overflow-hidden bg-[#061827] text-white">
        <div
          aria-hidden="true"
          className="absolute inset-0 opacity-[0.055] [background-image:linear-gradient(rgba(255,255,255,.26)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.26)_1px,transparent_1px)] [background-size:72px_72px]"
        />


        <div
          aria-hidden="true"
          className="absolute -right-[250px] -top-[280px] h-[760px] w-[760px] rounded-full bg-[#e31b2d]/15 blur-[130px]"
        />


        <div
          aria-hidden="true"
          className="absolute -bottom-[340px] left-[10%] h-[650px] w-[800px] rounded-full bg-[#377eb8]/10 blur-[150px]"
        />


        <motion.div
          aria-hidden="true"
          animate={
            reduceMotion
              ? undefined
              : {
                  x: [
                    -90,
                    80,
                    -90,
                  ],

                  opacity: [
                    0.15,
                    0.48,
                    0.15,
                  ],
                }
          }
          transition={{
            duration:
              11,

            repeat:
              Infinity,

            ease:
              "easeInOut",
          }}
          className="absolute bottom-[12%] left-[5%] h-[3px] w-[58%] rotate-[-7deg] bg-gradient-to-r from-transparent via-[#e31b2d]/60 to-transparent blur-[2px]"
        />


        <div className="relative mx-auto max-w-[1480px] px-4 pb-14 pt-14 sm:px-6 lg:px-8 lg:pb-18 lg:pt-16">
          <div className="grid gap-12 xl:grid-cols-[minmax(0,0.92fr)_minmax(500px,1.08fr)] xl:items-center">
            <motion.div
              initial={
                reduceMotion
                  ? false
                  : {
                      x:
                        -35,

                      scale:
                        0.985,
                    }
              }
              animate={{
                x:
                  0,

                scale:
                  1,
              }}
              transition={{
                duration:
                  0.72,

                ease:
                  "easeOut",
              }}
            >
              <div className="inline-flex items-center gap-2 rounded-full border border-white/[0.10] bg-white/[0.055] px-3.5 py-2 backdrop-blur">
                <Navigation className="h-3.5 w-3.5 text-[#ff4b5a]" />

                <span className="text-[8px] font-black uppercase tracking-[0.17em] text-[#cad5dd]">
                  DELIVERY PROFILE
                </span>
              </div>


              <p className="mt-7 text-[10px] font-black uppercase tracking-[0.15em] text-[#718798]">
                {displayName}
              </p>


              <h1 className="mt-2 text-[52px] font-black leading-[0.92] tracking-[-0.06em] sm:text-[68px] lg:text-[78px]">
                Your places.
                <br />

                <span className="text-[#ff394a]">
                  Ready to deliver.
                </span>
              </h1>


              <p className="mt-7 max-w-[670px] text-[12px] leading-6 text-[#a8b9c6] sm:text-[13px]">
                Keep the delivery destinations
                you use most in one place and
                choose the default address that
                Vehnexa can use during checkout.
              </p>


              <div className="mt-8 flex flex-wrap gap-3">
                <button
                  type="button"
                  onClick={
                    openNewAddress
                  }
                  className="group inline-flex h-12 items-center gap-2 rounded-[9px] bg-[#e31b2d] px-6 text-[9px] font-black text-white shadow-[0_12px_34px_rgba(227,27,45,.20)] transition hover:bg-[#c91625]"
                >
                  <Plus className="h-4 w-4" />

                  Add address

                  <ArrowRight className="h-3.5 w-3.5 transition group-hover:translate-x-1" />
                </button>


                <Link
                  href="/account"
                  className="inline-flex h-12 items-center gap-2 rounded-[9px] border border-white/[0.13] bg-white/[0.045] px-6 text-[9px] font-black text-white transition hover:bg-white/[0.09]"
                >
                  <LayoutDashboard className="h-4 w-4" />

                  Account overview
                </Link>
              </div>
            </motion.div>


            {/* DEFAULT DELIVERY DESTINATION */}

            <motion.div
              initial={
                reduceMotion
                  ? false
                  : {
                      x:
                        45,

                      scale:
                        0.97,
                    }
              }
              animate={{
                x:
                  0,

                scale:
                  1,
              }}
              transition={{
                delay:
                  0.08,

                duration:
                  0.75,

                ease:
                  "easeOut",
              }}
              className="relative overflow-hidden rounded-[24px] border border-white/[0.11] bg-white/[0.055] p-6 shadow-[0_34px_90px_rgba(0,0,0,.20)] backdrop-blur-xl sm:p-7"
            >
              <div
                aria-hidden="true"
                className="absolute -right-24 -top-24 h-[340px] w-[340px] rounded-full border border-white/[0.06]"
              />

              <div
                aria-hidden="true"
                className="absolute -right-6 top-4 h-[230px] w-[230px] rounded-full border border-[#e31b2d]/10"
              />


              <div className="relative">
                <div className="flex items-start justify-between gap-5">
                  <div>
                    <p className="text-[7px] font-black uppercase tracking-[0.14em] text-[#718798]">
                      DEFAULT DESTINATION
                    </p>

                    <h2 className="mt-2 text-[23px] font-black tracking-[-0.035em] text-white">
                      {defaultAddress
                        ? defaultAddress.label
                        : "No default address yet"}
                    </h2>
                  </div>


                  <span
                    className={
                      defaultAddress
                        ? "flex h-11 w-11 items-center justify-center rounded-full border border-[#61d49a]/20 bg-[#61d49a]/10 text-[#70dda7]"
                        : "flex h-11 w-11 items-center justify-center rounded-full border border-white/[0.09] bg-white/[0.04] text-[#718798]"
                    }
                  >
                    {defaultAddress ? (
                      <BadgeCheck className="h-4.5 w-4.5" />
                    ) : (
                      <MapPin className="h-4.5 w-4.5" />
                    )}
                  </span>
                </div>


                {defaultAddress ? (
                  <div className="mt-7">
                    <p className="text-[9px] font-bold text-[#dbe4eb]">
                      {
                        defaultAddress.recipient_name
                      }
                    </p>


                    <p className="mt-3 max-w-[500px] text-[9px] leading-5 text-[#9aadb9]">
                      {
                        defaultAddress.address_line1
                      }

                      {defaultAddress.address_line2
                        ? `, ${defaultAddress.address_line2}`
                        : ""}
                    </p>


                    <p className="mt-1 text-[9px] leading-5 text-[#9aadb9]">
                      {[
                        defaultAddress.city,
                        defaultAddress.region,
                        defaultAddress.country,
                      ]
                        .filter(
                          Boolean,
                        )
                        .join(
                          ", ",
                        )}
                    </p>


                    <div className="mt-5 inline-flex items-center gap-2 rounded-[9px] border border-white/[0.08] bg-black/10 px-3.5 py-2.5">
                      <Phone className="h-3.5 w-3.5 text-[#ff5966]" />

                      <span className="text-[8px] font-bold text-[#dbe4eb]">
                        {
                          defaultAddress.phone
                        }
                      </span>
                    </div>
                  </div>
                ) : (
                  <div className="mt-7 rounded-[14px] border border-dashed border-white/[0.12] bg-black/10 px-5 py-8">
                    <MapPin className="h-6 w-6 text-[#718798]" />

                    <p className="mt-4 text-[10px] font-black text-[#dbe4eb]">
                      Add your first delivery destination
                    </p>

                    <p className="mt-2 max-w-[420px] text-[8px] leading-4 text-[#8195a5]">
                      A saved address gives checkout
                      a reusable delivery destination.
                    </p>
                  </div>
                )}


                <div className="mt-7 grid grid-cols-3 gap-2">
                  <HeroMetric
                    label="Saved"
                    value={
                      String(
                        addresses.length,
                      )
                    }
                  />

                  <HeroMetric
                    label="Cities"
                    value={
                      String(
                        cityCount,
                      )
                    }
                  />

                  <HeroMetric
                    label="Countries"
                    value={
                      String(
                        countryCount,
                      )
                    }
                  />
                </div>
              </div>
            </motion.div>
          </div>
        </div>
      </section>


      {/* ======================================================
          STATUS STRIP
      ====================================================== */}

      <section className="border-b border-[#e1e6ea] bg-white">
        <div className="mx-auto grid max-w-[1480px] sm:grid-cols-3">
          <AddressSignal
            icon={
              MapPin
            }
            eyebrow="SAVED DESTINATIONS"
            title={`${addresses.length} ${
              addresses.length ===
              1
                ? "address"
                : "addresses"
            }`}
            detail="Reusable delivery information stored on your customer account."
          />


          <AddressSignal
            icon={
              BadgeCheck
            }
            eyebrow="DEFAULT ADDRESS"
            title={
              defaultAddress
                ? defaultAddress.label
                : "Not selected"
            }
            detail="Your default destination can be selected automatically during checkout."
          />


          <AddressSignal
            icon={
              ShieldCheck
            }
            eyebrow="DELIVERY PROFILE"
            title={
              addresses.length >
              0
                ? "Ready"
                : "Needs an address"
            }
            detail="Manage recipients, phone numbers and location details from one place."
          />
        </div>
      </section>


      {/* ======================================================
          ACCOUNT AREA
      ====================================================== */}

      <section className="mx-auto max-w-[1480px] px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
        {error && (
          <motion.div
            initial={{
              y:
                -8,
            }}
            animate={{
              y:
                0,
            }}
            className="mb-6 flex items-start gap-3 rounded-[12px] border border-[#f1c7cc] bg-[#fff4f5] px-5 py-4"
          >
            <span className="flex h-8 w-8 shrink-0 items-center justify-center rounded-[8px] bg-[#ffe4e7] text-[#b4232f]">
              <X className="h-3.5 w-3.5" />
            </span>

            <div>
              <p className="text-[8px] font-black uppercase tracking-[0.10em] text-[#b4232f]">
                ADDRESS ACTION FAILED
              </p>

              <p className="mt-1 text-[8px] text-[#9e303d]">
                {
                  error
                }
              </p>
            </div>
          </motion.div>
        )}


        {success && (
          <motion.div
            initial={{
              y:
                -8,
            }}
            animate={{
              y:
                0,
            }}
            className="mb-6 flex items-center gap-3 rounded-[12px] border border-[#b7e4c7] bg-[#ecfdf3] px-5 py-4"
          >
            <CheckCircle2 className="h-4 w-4 text-[#16804a]" />

            <p className="text-[8px] font-black text-[#087443]">
              {
                success
              }
            </p>
          </motion.div>
        )}


        <div className="grid gap-7 xl:grid-cols-[230px_minmax(0,1fr)]">
          <AddressesSidebar
            initials={
              initials
            }
            displayName={
              displayName
            }
            email={
              user?.email ??
              ""
            }
          />


          <div className="min-w-0">
            <div className="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
              <div>
                <p className="text-[8px] font-black uppercase tracking-[0.16em] text-[#e31b2d]">
                  DELIVERY DESTINATIONS
                </p>

                <h2 className="mt-3 text-[36px] font-black tracking-[-0.045em] text-[#101828] sm:text-[46px]">
                  Places you trust.
                </h2>

                <p className="mt-4 max-w-[680px] text-[10px] leading-5 text-[#667085]">
                  Store multiple destinations,
                  edit delivery information at any
                  time and choose which location
                  should act as the account default.
                </p>
              </div>


              <button
                type="button"
                onClick={
                  openNewAddress
                }
                className="group inline-flex h-11 self-start items-center gap-2 rounded-[8px] bg-[#071b2d] px-5 text-[8px] font-black text-white transition hover:bg-[#102d43] lg:self-auto"
              >
                <Plus className="h-3.5 w-3.5" />

                Add destination

                <ArrowRight className="h-3 w-3 transition group-hover:translate-x-1" />
              </button>
            </div>


            {/* ==================================================
                EDITOR
            ================================================== */}

            <AnimatePresence
              initial={false}
            >
              {formOpen && (
                <motion.form
                  key={
                    editingId ??
                    "new-address"
                  }
                  onSubmit={
                    submitAddress
                  }
                  initial={
                    reduceMotion
                      ? false
                      : {
                          y:
                            18,

                          scale:
                            0.99,
                        }
                  }
                  animate={{
                    y:
                      0,

                    scale:
                      1,
                  }}
                  exit={{
                    y:
                      -10,

                    opacity:
                      0,
                  }}
                  transition={{
                    duration:
                      0.3,
                  }}
                  className="mt-8 overflow-hidden rounded-[20px] border border-[#d8dee6] bg-white shadow-[0_18px_50px_rgba(15,23,42,.07)]"
                >
                  <div className="grid xl:grid-cols-[minmax(0,1fr)_340px]">
                    <div className="p-6 sm:p-7">
                      <div className="flex items-start justify-between gap-5">
                        <div>
                          <div className="flex items-center gap-2">
                            <span className="flex h-9 w-9 items-center justify-center rounded-[9px] bg-[#071b2d] text-white">
                              {editingId ? (
                                <Edit3 className="h-4 w-4" />
                              ) : (
                                <Plus className="h-4 w-4" />
                              )}
                            </span>


                            <p className="text-[7px] font-black uppercase tracking-[0.15em] text-[#e31b2d]">
                              {editingId
                                ? "EDIT DESTINATION"
                                : "NEW DESTINATION"}
                            </p>
                          </div>


                          <h3 className="mt-4 text-[23px] font-black tracking-[-0.035em] text-[#101828]">
                            {editingId
                              ? "Update delivery details."
                              : "Build a delivery profile."}
                          </h3>


                          <p className="mt-2 max-w-[580px] text-[9px] leading-5 text-[#667085]">
                            Enter the recipient and
                            location details exactly
                            as they should appear on
                            an order.
                          </p>
                        </div>


                        <button
                          type="button"
                          onClick={
                            resetForm
                          }
                          aria-label="Close address form"
                          className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[#e1e5e9] text-[#667085] transition hover:bg-[#f5f7f9]"
                        >
                          <X className="h-4 w-4" />
                        </button>
                      </div>


                      <div className="mt-7 grid gap-5 sm:grid-cols-2">
                        <AddressInput
                          label="Address label"
                          value={
                            form.label
                          }
                          placeholder="Home"
                          icon={
                            Home
                          }
                          onChange={(
                            value,
                          ) =>
                            updateField(
                              "label",
                              value,
                            )
                          }
                        />


                        <AddressInput
                          label="Recipient name"
                          value={
                            form.recipient_name
                          }
                          placeholder="Full name"
                          icon={
                            UserRound
                          }
                          onChange={(
                            value,
                          ) =>
                            updateField(
                              "recipient_name",
                              value,
                            )
                          }
                        />


                        <AddressInput
                          label="Phone"
                          value={
                            form.phone
                          }
                          placeholder="+961..."
                          icon={
                            Phone
                          }
                          onChange={(
                            value,
                          ) =>
                            updateField(
                              "phone",
                              value,
                            )
                          }
                        />


                        <AddressInput
                          label="Country"
                          value={
                            form.country
                          }
                          placeholder="Lebanon"
                          icon={
                            Navigation
                          }
                          onChange={(
                            value,
                          ) =>
                            updateField(
                              "country",
                              value,
                            )
                          }
                        />


                        <div className="sm:col-span-2">
                          <AddressInput
                            label="Address line 1"
                            value={
                              form.address_line1
                            }
                            placeholder="Street, building, floor..."
                            icon={
                              MapPin
                            }
                            onChange={(
                              value,
                            ) =>
                              updateField(
                                "address_line1",
                                value,
                              )
                            }
                          />
                        </div>


                        <div className="sm:col-span-2">
                          <AddressInput
                            label="Address line 2"
                            optional
                            value={
                              form.address_line2
                            }
                            placeholder="Apartment, landmark..."
                            icon={
                              MapPin
                            }
                            onChange={(
                              value,
                            ) =>
                              updateField(
                                "address_line2",
                                value,
                              )
                            }
                          />
                        </div>


                        <AddressInput
                          label="City"
                          value={
                            form.city
                          }
                          placeholder="Tripoli"
                          icon={
                            Navigation
                          }
                          onChange={(
                            value,
                          ) =>
                            updateField(
                              "city",
                              value,
                            )
                          }
                        />


                        <AddressInput
                          label="Region"
                          optional
                          value={
                            form.region
                          }
                          placeholder="North Lebanon"
                          icon={
                            Navigation
                          }
                          onChange={(
                            value,
                          ) =>
                            updateField(
                              "region",
                              value,
                            )
                          }
                        />


                        <AddressInput
                          label="Postal code"
                          optional
                          value={
                            form.postal_code
                          }
                          placeholder="Postal code"
                          icon={
                            Navigation
                          }
                          onChange={(
                            value,
                          ) =>
                            updateField(
                              "postal_code",
                              value,
                            )
                          }
                        />
                      </div>


                      <div className="mt-7 flex flex-wrap justify-end gap-3 border-t border-[#edf0f2] pt-6">
                        <button
                          type="button"
                          onClick={
                            resetForm
                          }
                          className="h-11 rounded-[8px] border border-[#d0d5dd] px-5 text-[8px] font-black text-[#475467] transition hover:bg-[#f8fafb]"
                        >
                          Cancel
                        </button>


                        <button
                          type="submit"
                          disabled={
                            saving
                          }
                          className="inline-flex h-11 items-center gap-2 rounded-[8px] bg-[#e31b2d] px-6 text-[8px] font-black text-white shadow-[0_10px_28px_rgba(227,27,45,.17)] transition hover:bg-[#c91625] disabled:cursor-not-allowed disabled:opacity-50"
                        >
                          {saving ? (
                            <Loader2 className="h-4 w-4 animate-spin" />
                          ) : (
                            <Check className="h-4 w-4" />
                          )}


                          {saving
                            ? "Saving..."
                            : editingId
                              ? "Save changes"
                              : "Save address"}
                        </button>
                      </div>
                    </div>


                    <AddressFormPreview
                      form={
                        form
                      }
                    />
                  </div>
                </motion.form>
              )}
            </AnimatePresence>


            {/* ==================================================
                LIST
            ================================================== */}

            {loading ? (
              <AddressesLoading />
            ) : addresses.length ===
              0 ? (
              <EmptyAddresses
                onAdd={
                  openNewAddress
                }
              />
            ) : (
              <motion.div
                layout
                className="mt-8 grid gap-5 lg:grid-cols-2"
              >
                <AnimatePresence
                  mode="popLayout"
                >
                  {sortedAddresses.map(
                    (
                      address,
                      index,
                    ) => (
                      <AddressCard
                        key={
                          address.id
                        }
                        address={
                          address
                        }
                        index={
                          index
                        }
                        onEdit={
                          openEdit
                        }
                        onDelete={
                          removeAddress
                        }
                        onDefault={
                          makeDefault
                        }
                      />
                    ),
                  )}
                </AnimatePresence>
              </motion.div>
            )}


            {/* ==================================================
                CHECKOUT BRIDGE
            ================================================== */}

            <div className="relative mt-10 overflow-hidden rounded-[22px] bg-[#071b2d] p-7 text-white shadow-[0_24px_70px_rgba(7,27,45,.14)] sm:p-9">
              <div
                aria-hidden="true"
                className="absolute -right-[110px] -top-[160px] h-[420px] w-[420px] rounded-full bg-[#e31b2d]/15 blur-[100px]"
              />


              <div className="relative flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between">
                <div>
                  <p className="text-[7px] font-black uppercase tracking-[0.15em] text-[#ff5b68]">
                    DELIVERY → CHECKOUT
                  </p>

                  <h3 className="mt-2 text-[27px] font-black tracking-[-0.04em] sm:text-[34px]">
                    Save it once. Reuse it at checkout.
                  </h3>

                  <p className="mt-3 max-w-[660px] text-[9px] leading-5 text-[#9fb0bd]">
                    Keep your delivery information
                    current here so checkout can
                    reuse your saved destination
                    instead of asking you to enter
                    it again.
                  </p>
                </div>


                <Link
                  href="/shop"
                  className="group inline-flex h-11 shrink-0 items-center gap-2 self-start rounded-[8px] bg-[#e31b2d] px-5 text-[8px] font-black text-white transition hover:bg-[#c91625] lg:self-auto"
                >
                  Continue shopping

                  <ArrowRight className="h-3.5 w-3.5 transition group-hover:translate-x-1" />
                </Link>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  );
}


/* ============================================================
   ADDRESS CARD
============================================================ */

function AddressCard({
  address,
  index,
  onEdit,
  onDelete,
  onDefault,
}: {
  address:
    Address;

  index:
    number;

  onEdit: (
    address:
      Address,
  ) => void;

  onDelete: (
    address:
      Address,
  ) => Promise<void>;

  onDefault: (
    addressId:
      string,
  ) => Promise<void>;
}) {
  const reduceMotion =
    useReducedMotion();


  return (
    <motion.article
      layout
      initial={
        reduceMotion
          ? false
          : {
              y:
                24,

              scale:
                0.99,
            }
      }
      animate={{
        y:
          0,

        scale:
          1,
      }}
      exit={{
        opacity:
          0,

        scale:
          0.96,
      }}
      transition={{
        delay:
          reduceMotion
            ? 0
            : Math.min(
                index *
                  0.05,
                0.25,
              ),

        duration:
          0.45,
      }}
      whileHover={
        reduceMotion
          ? undefined
          : {
              y:
                -5,
            }
      }
      className={`relative overflow-hidden rounded-[18px] border bg-white shadow-[0_10px_34px_rgba(15,23,42,.04)] ${
        address.is_default
          ? "border-[#b9e0c7] ring-1 ring-[#16804a]/[0.05]"
          : "border-[#dce2e7]"
      }`}
    >
      {address.is_default && (
        <div className="h-[3px] bg-gradient-to-r from-[#16804a] via-[#61d49a] to-[#16804a]" />
      )}


      <div className="p-5 sm:p-6">
        <div className="flex items-start justify-between gap-4">
          <div className="flex min-w-0 items-center gap-3">
            <span
              className={
                address.is_default
                  ? "flex h-11 w-11 shrink-0 items-center justify-center rounded-[10px] bg-[#ecfdf3] text-[#16804a]"
                  : "flex h-11 w-11 shrink-0 items-center justify-center rounded-[10px] bg-[#f3f5f7] text-[#596775]"
              }
            >
              <Home className="h-[18px] w-[18px]" />
            </span>


            <div className="min-w-0">
              <div className="flex flex-wrap items-center gap-2">
                <h3 className="truncate text-[14px] font-black tracking-[-0.02em] text-[#101828]">
                  {
                    address.label
                  }
                </h3>


                {address.is_default && (
                  <span className="inline-flex items-center gap-1 rounded-full border border-[#b9e4ca] bg-[#ecfdf3] px-2.5 py-1 text-[6px] font-black uppercase tracking-[0.07em] text-[#16804a]">
                    <BadgeCheck className="h-3 w-3" />

                    DEFAULT
                  </span>
                )}
              </div>


              <p className="mt-1 text-[8px] font-semibold text-[#667085]">
                {
                  address.recipient_name
                }
              </p>
            </div>
          </div>


          <div className="flex shrink-0 gap-1">
            <button
              type="button"
              onClick={() =>
                onEdit(
                  address,
                )
              }
              aria-label={`Edit ${address.label}`}
              className="flex h-9 w-9 items-center justify-center rounded-full border border-transparent text-[#667085] transition hover:border-[#dce2e7] hover:bg-[#f6f8fa] hover:text-[#101828]"
            >
              <Edit3 className="h-3.5 w-3.5" />
            </button>


            <button
              type="button"
              onClick={() => {
                void onDelete(
                  address,
                );
              }}
              aria-label={`Delete ${address.label}`}
              className="flex h-9 w-9 items-center justify-center rounded-full border border-transparent text-[#b42318] transition hover:border-[#f2c4c8] hover:bg-[#fff1f2]"
            >
              <Trash2 className="h-3.5 w-3.5" />
            </button>
          </div>
        </div>


        <div className="mt-6 rounded-[13px] border border-[#e8ecef] bg-[#fafbfc] p-4">
          <div className="flex gap-3">
            <MapPin className="mt-0.5 h-4 w-4 shrink-0 text-[#e31b2d]" />

            <div className="min-w-0 text-[8px] leading-5 text-[#596775]">
              <p className="font-bold text-[#344054]">
                {
                  address.address_line1
                }
              </p>


              {address.address_line2 && (
                <p>
                  {
                    address.address_line2
                  }
                </p>
              )}


              <p>
                {[
                  address.city,
                  address.region,
                  address.country,
                ]
                  .filter(
                    Boolean,
                  )
                  .join(
                    ", ",
                  )}
              </p>


              {address.postal_code && (
                <p>
                  {
                    address.postal_code
                  }
                </p>
              )}
            </div>
          </div>
        </div>


        <div className="mt-4 flex items-center gap-2 rounded-[9px] border border-[#edf0f2] px-3 py-2.5">
          <Phone className="h-3.5 w-3.5 text-[#98a2b3]" />

          <span className="text-[8px] font-bold text-[#475467]">
            {
              address.phone
            }
          </span>
        </div>


        <div className="mt-5 flex items-center justify-between gap-4 border-t border-[#edf0f2] pt-5">
          {address.is_default ? (
            <span className="inline-flex items-center gap-2 text-[7px] font-black text-[#16804a]">
              <CheckCircle2 className="h-3.5 w-3.5" />

              Checkout default
            </span>
          ) : (
            <button
              type="button"
              onClick={() => {
                void onDefault(
                  address.id,
                );
              }}
              className="inline-flex items-center gap-2 text-[7px] font-black text-[#e31b2d] transition hover:text-[#b81726]"
            >
              <Star className="h-3.5 w-3.5" />

              Set as default
            </button>
          )}


          <button
            type="button"
            onClick={() =>
              onEdit(
                address,
              )
            }
            className="group inline-flex items-center gap-1.5 text-[7px] font-black text-[#667085] transition hover:text-[#101828]"
          >
            Edit details

            <ArrowRight className="h-3 w-3 transition group-hover:translate-x-1" />
          </button>
        </div>
      </div>
    </motion.article>
  );
}


/* ============================================================
   FORM PREVIEW
============================================================ */

function AddressFormPreview({
  form,
}: {
  form:
    AddressFormState;
}) {
  const location =
    [
      form.city,
      form.region,
      form.country,
    ]
      .filter(
        Boolean,
      )
      .join(
        ", ",
      );


  return (
    <aside className="relative overflow-hidden bg-[#071b2d] p-6 text-white sm:p-7">
      <div
        aria-hidden="true"
        className="absolute -right-20 -top-20 h-72 w-72 rounded-full border border-white/[0.07]"
      />

      <div
        aria-hidden="true"
        className="absolute -right-6 -top-6 h-48 w-48 rounded-full border border-[#e31b2d]/15"
      />


      <div className="relative">
        <p className="text-[7px] font-black uppercase tracking-[0.15em] text-[#718798]">
          LIVE DELIVERY PREVIEW
        </p>


        <span className="mt-6 flex h-14 w-14 items-center justify-center rounded-[13px] border border-white/[0.10] bg-white/[0.05] text-[#ff5966]">
          <MapPin className="h-5 w-5" />
        </span>


        <h3 className="mt-6 text-[23px] font-black tracking-[-0.035em]">
          {form.label.trim() ||
            "Untitled address"}
        </h3>


        <p className="mt-2 text-[9px] font-bold text-[#cbd6de]">
          {form.recipient_name.trim() ||
            "Recipient name"}
        </p>


        <div className="mt-6 min-h-[145px] rounded-[13px] border border-white/[0.08] bg-black/10 p-4">
          <p className="text-[8px] font-semibold leading-5 text-[#a3b4c1]">
            {form.address_line1.trim() ||
              "Street, building, floor"}
          </p>


          {form.address_line2.trim() && (
            <p className="text-[8px] leading-5 text-[#8fa3b2]">
              {
                form.address_line2
              }
            </p>
          )}


          <p className="mt-2 text-[8px] leading-5 text-[#a3b4c1]">
            {location ||
              "City, region, country"}
          </p>


          {form.postal_code.trim() && (
            <p className="mt-1 text-[8px] text-[#8fa3b2]">
              {
                form.postal_code
              }
            </p>
          )}
        </div>


        <div className="mt-4 flex items-center gap-2 rounded-[10px] border border-white/[0.08] bg-white/[0.04] px-3 py-3">
          <Phone className="h-3.5 w-3.5 text-[#ff5966]" />

          <span className="text-[8px] font-bold text-[#dbe4eb]">
            {form.phone.trim() ||
              "Recipient phone"}
          </span>
        </div>


        <div className="mt-7 border-t border-white/[0.07] pt-5">
          <p className="text-[7px] leading-4 text-[#718798]">
            Preview only. The address will be
            saved after the form is submitted
            successfully.
          </p>
        </div>
      </div>
    </aside>
  );
}


/* ============================================================
   ADDRESS INPUT
============================================================ */

function AddressInput({
  label,
  value,
  placeholder,
  optional =
    false,
  icon:
    Icon,
  onChange,
}: {
  label:
    string;

  value:
    string;

  placeholder:
    string;

  optional?:
    boolean;

  icon:
    LucideIcon;

  onChange:
    (
      value:
        string,
    ) =>
      void;
}) {
  return (
    <label className="block">
      <div className="mb-2 flex items-center gap-2">
        <span className="text-[8px] font-black uppercase tracking-[0.09em] text-[#596775]">
          {
            label
          }
        </span>


        {optional && (
          <span className="rounded-full bg-[#f2f4f7] px-2 py-0.5 text-[6px] font-bold uppercase tracking-[0.07em] text-[#98a2b3]">
            Optional
          </span>
        )}
      </div>


      <div className="relative">
        <Icon className="pointer-events-none absolute left-3.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[#98a2b3]" />


        <input
          value={
            value
          }
          onChange={(
            event,
          ) =>
            onChange(
              event.target.value,
            )
          }
          placeholder={
            placeholder
          }
          className="h-[52px] w-full rounded-[10px] border border-[#d2d9df] bg-white pl-10 pr-4 text-[9px] font-semibold text-[#17202b] outline-none transition placeholder:text-[#a0a9b3] focus:border-[#e31b2d]/55 focus:ring-4 focus:ring-[#e31b2d]/[0.05]"
        />
      </div>
    </label>
  );
}


/* ============================================================
   EMPTY
============================================================ */

function EmptyAddresses({
  onAdd,
}: {
  onAdd:
    () => void;
}) {
  const reduceMotion =
    useReducedMotion();


  return (
    <section className="relative mt-8 flex min-h-[500px] items-center justify-center overflow-hidden rounded-[22px] border border-[#dce2e7] bg-white px-6 py-12 shadow-[0_12px_40px_rgba(15,23,42,.04)]">
      <div
        aria-hidden="true"
        className="absolute h-[420px] w-[420px] rounded-full border border-[#edf0f2]"
      />

      <div
        aria-hidden="true"
        className="absolute h-[290px] w-[290px] rounded-full border border-[#f1d8da]"
      />


      <div className="relative z-10 max-w-[470px] text-center">
        <motion.div
          animate={
            reduceMotion
              ? undefined
              : {
                  y: [
                    0,
                    -9,
                    0,
                  ],
                }
          }
          transition={{
            duration:
              4,

            repeat:
              Infinity,

            ease:
              "easeInOut",
          }}
          className="mx-auto flex h-20 w-20 items-center justify-center rounded-[20px] bg-[#071b2d] text-white shadow-[0_18px_40px_rgba(7,27,45,.16)]"
        >
          <MapPin className="h-8 w-8" />
        </motion.div>


        <p className="mt-7 text-[8px] font-black uppercase tracking-[0.15em] text-[#e31b2d]">
          NO SAVED DESTINATIONS
        </p>


        <h3 className="mt-3 text-[30px] font-black tracking-[-0.045em] text-[#101828]">
          Your first delivery address starts here.
        </h3>


        <p className="mt-4 text-[10px] leading-5 text-[#667085]">
          Save a destination once so it can be
          reused later during the Vehnexa checkout
          experience.
        </p>


        <button
          type="button"
          onClick={
            onAdd
          }
          className="group mx-auto mt-7 inline-flex h-11 items-center gap-2 rounded-[8px] bg-[#e31b2d] px-6 text-[8px] font-black text-white transition hover:bg-[#c91625]"
        >
          <Plus className="h-4 w-4" />

          Add your first address

          <ArrowRight className="h-3.5 w-3.5 transition group-hover:translate-x-1" />
        </button>
      </div>
    </section>
  );
}


/* ============================================================
   LOADING
============================================================ */

function AddressesLoading() {
  return (
    <div className="mt-8 grid gap-5 lg:grid-cols-2">
      {[
        1,
        2,
        3,
        4,
      ].map(
        (
          item,
        ) => (
          <div
            key={
              item
            }
            className="h-[300px] animate-pulse rounded-[18px] border border-[#e1e5e9] bg-white"
          />
        ),
      )}
    </div>
  );
}


/* ============================================================
   HERO METRIC
============================================================ */

function HeroMetric({
  label,
  value,
}: {
  label:
    string;

  value:
    string;
}) {
  return (
    <div className="rounded-[9px] border border-white/[0.07] bg-black/10 p-3">
      <p className="text-[6px] font-black uppercase tracking-[0.11em] text-[#657b8c]">
        {
          label
        }
      </p>

      <p className="mt-1 text-[16px] font-black text-white">
        {
          value
        }
      </p>
    </div>
  );
}


/* ============================================================
   STATUS SIGNAL
============================================================ */

function AddressSignal({
  icon:
    Icon,
  eyebrow,
  title,
  detail,
}: {
  icon:
    LucideIcon;

  eyebrow:
    string;

  title:
    string;

  detail:
    string;
}) {
  return (
    <div className="group flex gap-4 border-b border-[#edf0f2] px-5 py-6 last:border-b-0 sm:border-b-0 sm:border-r sm:last:border-r-0 lg:px-8">
      <span className="flex h-11 w-11 shrink-0 items-center justify-center rounded-[10px] border border-[#e0e5e9] bg-[#f5f7f9] text-[#596b7a] transition duration-300 group-hover:border-[#efc8cc] group-hover:bg-[#fff0f1] group-hover:text-[#e31b2d]">
        <Icon className="h-[18px] w-[18px]" />
      </span>


      <div className="min-w-0">
        <p className="text-[7px] font-black uppercase tracking-[0.13em] text-[#98a2b3]">
          {
            eyebrow
          }
        </p>

        <p className="mt-1 truncate text-[11px] font-black text-[#101828]">
          {
            title
          }
        </p>

        <p className="mt-1.5 text-[7px] leading-4 text-[#7b8794]">
          {
            detail
          }
        </p>
      </div>
    </div>
  );
}


/* ============================================================
   ACCOUNT SIDEBAR
============================================================ */

function AddressesSidebar({
  initials,
  displayName,
  email,
}: {
  initials:
    string;

  displayName:
    string;

  email:
    string;
}) {
  return (
    <aside className="self-start overflow-hidden rounded-[17px] border border-[#dce2e7] bg-white shadow-[0_12px_38px_rgba(15,23,42,.045)] xl:sticky xl:top-[88px]">
      <div className="border-b border-[#edf0f2] p-5">
        <div className="flex items-center gap-3">
          <span className="flex h-12 w-12 shrink-0 items-center justify-center rounded-[12px] bg-[#071b2d] text-[12px] font-black text-white">
            {
              initials
            }
          </span>


          <div className="min-w-0">
            <p className="truncate text-[10px] font-black text-[#101828]">
              {
                displayName
              }
            </p>

            <p className="mt-1 truncate text-[7px] text-[#98a2b3]">
              {
                email
              }
            </p>
          </div>
        </div>
      </div>


      <nav className="space-y-1 p-3">
        <SidebarLink
          icon={
            LayoutDashboard
          }
          label="Overview"
          href="/account"
        />

        <SidebarLink
          icon={
            Package
          }
          label="Orders"
          href="/orders"
        />

        <SidebarLink
          icon={
            Navigation
          }
          label="My Garage"
          href="/account/garage"
        />

        <SidebarLink
          icon={
            MapPin
          }
          label="Addresses"
          href="/account/addresses"
          active
        />

        <SidebarLink
          icon={
            Heart
          }
          label="Wishlist"
          href="/account/wishlist"
        />

        <SidebarLink
          icon={
            Bell
          }
          label="Notifications"
          href="/account/notifications"
        />
      </nav>


      <div className="border-t border-[#edf0f2] p-4">
        <Link
          href="/shop"
          className="group flex h-10 items-center justify-between rounded-[8px] bg-[#f6f8fa] px-3 text-[8px] font-bold text-[#475467] transition hover:bg-[#eef1f4]"
        >
          Continue shopping

          <ArrowRight className="h-3.5 w-3.5 transition group-hover:translate-x-1" />
        </Link>
      </div>
    </aside>
  );
}


function SidebarLink({
  icon:
    Icon,
  label,
  href,
  active =
    false,
}: {
  icon:
    LucideIcon;

  label:
    string;

  href:
    string;

  active?:
    boolean;
}) {
  return (
    <Link
      href={
        href
      }
      className={
        active
          ? "flex h-10 items-center gap-3 rounded-[8px] bg-[#fff0f1] px-3 text-[8px] font-black text-[#e31b2d]"
          : "flex h-10 items-center gap-3 rounded-[8px] px-3 text-[8px] font-bold text-[#596775] transition hover:bg-[#f6f8fa] hover:text-[#101828]"
      }
    >
      <Icon className="h-4 w-4" />

      {
        label
      }
    </Link>
  );
}


/* ============================================================
   NAVBAR
============================================================ */

function AddressesNavbar({
  cartCount,
}: {
  cartCount:
    number;
}) {
  const reduceMotion =
    useReducedMotion();


  return (
    <motion.header
      initial={
        reduceMotion
          ? false
          : {
              y:
                -65,
            }
      }
      animate={{
        y:
          0,
      }}
      transition={{
        duration:
          0.55,

        ease:
          "easeOut",
      }}
      className="sticky top-0 z-50 border-b border-white/[0.07] bg-[#061827]/95 shadow-[0_8px_30px_rgba(0,0,0,.08)] backdrop-blur-xl"
    >
      <div className="mx-auto flex h-[66px] max-w-[1480px] items-center px-4 sm:px-6 lg:px-8">
        <Link
          href="/"
          className="flex shrink-0 items-center gap-2.5"
        >
          <VehnexaMark />

          <span className="text-[14px] font-black tracking-[-0.025em] text-white">
            Vehnexa
          </span>
        </Link>


        <nav className="ml-10 hidden h-full items-center gap-8 lg:flex">
          <TopNavLink
            href="/shop"
            label="Shop"
          />

          <TopNavLink
            href="/account/garage"
            label="My Garage"
          />

          <TopNavLink
            href="/ai-mechanic"
            label="AI Mechanic"
          />

          <TopNavLink
            href="/#resources"
            label="Resources"
          />
        </nav>


        <div className="ml-auto flex items-center gap-1.5">
          <Link
            href="/shop"
            aria-label="Search parts"
            className="flex h-9 w-9 items-center justify-center rounded-full text-[#c7d3dc] transition hover:bg-white/[0.06] hover:text-white"
          >
            <Search className="h-[16px] w-[16px]" />
          </Link>


          <Link
            href="/cart"
            aria-label={`Cart with ${cartCount} items`}
            className="relative flex h-9 w-9 items-center justify-center rounded-full text-[#c7d3dc] transition hover:bg-white/[0.06] hover:text-white"
          >
            <ShoppingCart className="h-[16px] w-[16px]" />


            {cartCount >
              0 && (
              <span className="absolute right-0 top-0 flex min-h-[16px] min-w-[16px] items-center justify-center rounded-full bg-[#e31b2d] px-1 text-[7px] font-black text-white">
                {cartCount >
                99
                  ? "99+"
                  : cartCount}
              </span>
            )}
          </Link>


          <NavbarNotificationBell />


          <Link
            href="/account"
            aria-label="Account"
            title="Account"
            className="flex h-9 w-9 items-center justify-center rounded-full text-[#c7d3dc] transition hover:bg-white/[0.06] hover:text-white"
          >
            <UserRound className="h-[16px] w-[16px]" />
          </Link>


          <CustomerLogoutButton />
        </div>
      </div>
    </motion.header>
  );
}


/* ============================================================
   TOP NAV
============================================================ */

function TopNavLink({
  href,
  label,
}: {
  href:
    string;

  label:
    string;
}) {
  return (
    <Link
      href={
        href
      }
      className="group relative flex h-full items-center text-[9px] font-semibold text-[#bcc9d3] transition hover:text-white"
    >
      {
        label
      }

      <span className="absolute bottom-0 left-1/2 h-[2px] w-0 -translate-x-1/2 bg-[#e31b2d] transition-all duration-300 group-hover:w-full" />
    </Link>
  );
}


/* ============================================================
   LOGO
============================================================ */

function VehnexaMark() {
  return (
    <div
      className="relative h-[25px] w-[30px] shrink-0"
      aria-hidden="true"
    >
      <span
        className="absolute left-0 top-[2px] h-[18px] w-[12px] bg-[#f03a45]"
        style={{
          clipPath:
            "polygon(0 0, 100% 0, 66% 100%, 42% 100%)",

          transform:
            "skewX(7deg)",
        }}
      />

      <span
        className="absolute left-[8px] top-[5px] h-[18px] w-[13px] bg-[#f08c2e]"
        style={{
          clipPath:
            "polygon(0 0, 100% 0, 52% 100%, 30% 100%)",

          transform:
            "skewX(-4deg)",
        }}
      />

      <span
        className="absolute right-0 top-[2px] h-[20px] w-[16px] bg-[#d9e1e8]"
        style={{
          clipPath:
            "polygon(12% 0, 100% 0, 53% 100%, 0 100%)",

          transform:
            "skewX(-7deg)",
        }}
      />
    </div>
  );
}
