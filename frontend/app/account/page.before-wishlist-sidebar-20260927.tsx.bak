"use client";

import CustomerLogoutButton from "@/components/customer/CustomerLogoutButton";

import NavbarNotificationBell from "@/components/notifications/NavbarNotificationBell";

import Link from "next/link";

import {
  type ReactNode,
  useCallback,
  useEffect,
  useState,
} from "react";

import {
  useRouter,
} from "next/navigation";

import {
  motion,
  useReducedMotion,
} from "framer-motion";

import {
  ArrowRight,
  BadgeCheck,
  Bell,
  CarFront,
  CheckCircle2,
  ChevronRight,
  CircleGauge,
  Heart,
  LayoutDashboard,
  Loader2,
  MapPin,
  Package,
  Search,
  ShoppingBag,
  ShoppingCart,
  Sparkles,
  UserRound,
  type LucideIcon,
} from "lucide-react";

import {
  ApiError,
  getCurrentUser,
  type UserPublic,
} from "@/lib/api";

import {
  getAccessToken,
  removeAccessToken,
} from "@/lib/auth";

import {
  getOrders,
} from "@/lib/orders";

import {
  getVehicles,
} from "@/lib/vehicles";

import {
  getAddresses,
} from "@/lib/addresses";

import {
  getWishlist,
} from "@/lib/wishlist";

import {
  getNotifications,
} from "@/lib/notifications";


type Orders =
  Awaited<
    ReturnType<
      typeof getOrders
    >
  >;


type Vehicles =
  Awaited<
    ReturnType<
      typeof getVehicles
    >
  >;


type Addresses =
  Awaited<
    ReturnType<
      typeof getAddresses
    >
  >;


type Wishlist =
  Awaited<
    ReturnType<
      typeof getWishlist
    >
  >;


type Notifications =
  Awaited<
    ReturnType<
      typeof getNotifications
    >
  >;


/* ============================================================
   ACCOUNT OVERVIEW
============================================================ */

export default function AccountPage() {
  const router =
    useRouter();


  const reduceMotion =
    useReducedMotion();


  const [
    user,
    setUser,
  ] =
    useState<
      UserPublic | null
    >(
      null,
    );


  const [
    orders,
    setOrders,
  ] =
    useState<Orders>(
      [],
    );


  const [
    vehicles,
    setVehicles,
  ] =
    useState<Vehicles>(
      [],
    );


  const [
    addresses,
    setAddresses,
  ] =
    useState<Addresses>(
      [],
    );


  const [
    wishlist,
    setWishlist,
  ] =
    useState<Wishlist>(
      [],
    );


  const [
    notifications,
    setNotifications,
  ] =
    useState<Notifications>(
      [],
    );


  const [
    loading,
    setLoading,
  ] =
    useState(
      true,
    );


  const [
    error,
    setError,
  ] =
    useState(
      "",
    );


  const [
    warnings,
    setWarnings,
  ] =
    useState<string[]>(
      [],
    );


  /* ==========================================================
     LOAD REAL ACCOUNT DATA
  ========================================================== */

  const loadOverview =
    useCallback(
      async () => {
        const token =
          getAccessToken();


        if (!token) {
          router.replace(
            "/login",
          );

          return;
        }


        try {
          setLoading(
            true,
          );

          setError(
            "",
          );


          const currentUser =
            await getCurrentUser(
              token,
            );


          const results =
            await Promise.allSettled(
              [
                getOrders(
                  token,
                ),

                getVehicles(
                  token,
                ),

                getAddresses(
                  token,
                ),

                getWishlist(
                  token,
                ),

                getNotifications(
                  token,
                ),
              ],
            );


          const unauthorized =
            results.some(
              (
                result,
              ) =>
                result.status ===
                  "rejected" &&
                result.reason instanceof
                  ApiError &&
                (
                  result.reason.status ===
                    401 ||
                  result.reason.status ===
                    403
                ),
            );


          if (
            unauthorized
          ) {
            removeAccessToken();

            router.replace(
              "/login",
            );

            return;
          }


          setUser(
            currentUser,
          );


          const [
            ordersResult,
            vehiclesResult,
            addressesResult,
            wishlistResult,
            notificationsResult,
          ] =
            results;


          setOrders(
            ordersResult.status ===
              "fulfilled"
              ? ordersResult.value
              : [],
          );


          setVehicles(
            vehiclesResult.status ===
              "fulfilled"
              ? vehiclesResult.value
              : [],
          );


          setAddresses(
            addressesResult.status ===
              "fulfilled"
              ? addressesResult.value
              : [],
          );


          setWishlist(
            wishlistResult.status ===
              "fulfilled"
              ? wishlistResult.value
              : [],
          );


          setNotifications(
            notificationsResult.status ===
              "fulfilled"
              ? notificationsResult.value
              : [],
          );


          const nextWarnings =
            results.flatMap(
              (
                result,
                index,
              ) => {
                if (
                  result.status ===
                  "fulfilled"
                ) {
                  return [];
                }


                const labels =
                  [
                    "orders",
                    "vehicles",
                    "addresses",
                    "wishlist",
                    "notifications",
                  ];


                return [
                  `Unable to load ${labels[index]}.`,
                ];
              },
            );


          setWarnings(
            nextWarnings,
          );

        } catch (
          loadError
        ) {
          if (
            loadError instanceof
              ApiError &&
            (
              loadError.status ===
                401 ||
              loadError.status ===
                403
            )
          ) {
            removeAccessToken();

            router.replace(
              "/login",
            );

            return;
          }


          setError(
            loadError instanceof
              Error
              ? loadError.message
              : "Unable to load your account.",
          );

        } finally {
          setLoading(
            false,
          );
        }
      },
      [
        router,
      ],
    );


  useEffect(() => {
    const timer =
      window.setTimeout(
        () => {
          void loadOverview();
        },
        0,
      );


    return () => {
      window.clearTimeout(
        timer,
      );
    };
  }, [
    loadOverview,
  ]);


  /* ==========================================================
     LOADING
  ========================================================== */

  if (
    loading &&
    !user
  ) {
    return (
      <AccountLoading />
    );
  }


  /* ==========================================================
     FATAL ERROR
  ========================================================== */

  if (!user) {
    return (
      <main className="flex min-h-screen items-center justify-center bg-[#f2f4f7] px-6">
        <div className="w-full max-w-[470px] rounded-[18px] border border-[#dce2e7] bg-white p-8 text-center shadow-[0_20px_60px_rgba(15,23,42,.08)]">
          <span className="mx-auto flex h-14 w-14 items-center justify-center rounded-[14px] bg-[#071b2d] text-white">
            <UserRound className="h-5 w-5" />
          </span>


          <h1 className="mt-5 text-[20px] font-black tracking-[-0.03em] text-[#101828]">
            Unable to load your account
          </h1>


          <p className="mt-3 text-[9px] leading-5 text-[#667085]">
            {error ||
              "Vehnexa could not load your customer profile."}
          </p>


          <button
            type="button"
            onClick={() => {
              void loadOverview();
            }}
            className="mt-6 h-10 rounded-[8px] bg-[#e31b2d] px-5 text-[8px] font-black text-white"
          >
            Try again
          </button>
        </div>
      </main>
    );
  }


  /* ==========================================================
     DERIVED DATA
  ========================================================== */

  const fullName =
    `${user.first_name} ${user.last_name}`.trim();


  const initials =
    `${user.first_name?.[0] ?? ""}${
      user.last_name?.[0] ?? ""
    }`
      .toUpperCase()
      .trim() ||
    "U";


  const activeVehicle =
    vehicles.find(
      (
        vehicle,
      ) =>
        vehicle.is_active,
    ) ??
    null;


  const defaultAddress =
    addresses.find(
      (
        address,
      ) =>
        address.is_default,
    ) ??
    addresses[0] ??
    null;


  const unreadCount =
    notifications.filter(
      (
        notification,
      ) =>
        !notification.is_read,
    ).length;


  const recentOrders =
    [
      ...orders,
    ]
      .sort(
        (
          a,
          b,
        ) =>
          new Date(
            b.created_at,
          ).getTime() -
          new Date(
            a.created_at,
          ).getTime(),
      )
      .slice(
        0,
        3,
      );


  const deliveredOrders =
    orders.filter(
      (
        order,
      ) =>
        order.status ===
        "delivered",
    ).length;


  /* ==========================================================
     RENDER
  ========================================================== */

  return (
    <main className="min-h-screen overflow-x-hidden bg-[#f2f4f7] text-[#101828]">
      <VehnexaNavbar />


      {/* ======================================================
          ACCOUNT HERO
      ====================================================== */}

      <section className="relative overflow-hidden bg-[#061827] text-white">
        <div
          aria-hidden="true"
          className="absolute inset-0 opacity-[0.055] [background-image:linear-gradient(rgba(255,255,255,.26)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.26)_1px,transparent_1px)] [background-size:72px_72px]"
        />


        <div
          aria-hidden="true"
          className="absolute -right-[240px] -top-[260px] h-[720px] w-[720px] rounded-full bg-[#e31b2d]/15 blur-[130px]"
        />


        <div
          aria-hidden="true"
          className="absolute -bottom-[340px] left-[10%] h-[620px] w-[780px] rounded-full bg-[#367db6]/10 blur-[150px]"
        />


        <motion.div
          aria-hidden="true"
          animate={
            reduceMotion
              ? undefined
              : {
                  x: [
                    -90,
                    70,
                    -90,
                  ],

                  opacity: [
                    0.16,
                    0.48,
                    0.16,
                  ],
                }
          }
          transition={{
            duration:
              11,

            repeat:
              Infinity,

            ease:
              "easeInOut",
          }}
          className="absolute bottom-[13%] left-[5%] h-[3px] w-[58%] rotate-[-7deg] bg-gradient-to-r from-transparent via-[#e31b2d]/60 to-transparent blur-[2px]"
        />


        <div className="relative mx-auto max-w-[1480px] px-4 pb-14 pt-14 sm:px-6 lg:px-8 lg:pb-18 lg:pt-16">
          <div className="grid gap-12 xl:grid-cols-[minmax(0,0.94fr)_minmax(500px,1.06fr)] xl:items-center">
            {/* LEFT */}

            <motion.div
              initial={
                reduceMotion
                  ? false
                  : {
                      x:
                        -35,

                      scale:
                        0.985,
                    }
              }
              animate={{
                x:
                  0,

                scale:
                  1,
              }}
              transition={{
                duration:
                  0.72,

                ease:
                  "easeOut",
              }}
            >
              <div className="inline-flex items-center gap-2 rounded-full border border-white/[0.10] bg-white/[0.055] px-3.5 py-2 backdrop-blur">
                <Sparkles className="h-3.5 w-3.5 text-[#ff4b5a]" />

                <span className="text-[8px] font-black uppercase tracking-[0.17em] text-[#cad5dd]">
                  CUSTOMER COMMAND CENTER
                </span>
              </div>


              <p className="mt-7 text-[10px] font-black uppercase tracking-[0.15em] text-[#718798]">
                Welcome back,
                {" "}
                {
                  user.first_name
                }
              </p>


              <h1 className="mt-2 text-[52px] font-black leading-[0.92] tracking-[-0.06em] sm:text-[68px] lg:text-[78px]">
                Everything
                <br />

                <span className="text-[#ff394a]">
                  in one place.
                </span>
              </h1>


              <p className="mt-7 max-w-[650px] text-[12px] leading-6 text-[#a8b9c6] sm:text-[13px]">
                Vehicles, orders, saved parts,
                delivery details and notifications
                come together here so you can
                move through Vehnexa without
                losing context.
              </p>


              <div className="mt-8 flex flex-wrap gap-3">
                <Link
                  href="/shop"
                  className="group inline-flex h-12 items-center gap-2 rounded-[9px] bg-[#e31b2d] px-6 text-[9px] font-black text-white shadow-[0_12px_34px_rgba(227,27,45,.20)] transition hover:bg-[#c91625]"
                >
                  <ShoppingBag className="h-4 w-4" />

                  Browse marketplace

                  <ArrowRight className="h-3.5 w-3.5 transition group-hover:translate-x-1" />
                </Link>


                <Link
                  href="/account/garage"
                  className="inline-flex h-12 items-center gap-2 rounded-[9px] border border-white/[0.13] bg-white/[0.045] px-6 text-[9px] font-black text-white transition hover:bg-white/[0.09]"
                >
                  <CarFront className="h-4 w-4" />

                  My Garage
                </Link>
              </div>
            </motion.div>


            {/* PROFILE PANEL */}

            <motion.div
              initial={
                reduceMotion
                  ? false
                  : {
                      x:
                        45,

                      scale:
                        0.97,
                    }
              }
              animate={{
                x:
                  0,

                scale:
                  1,
              }}
              transition={{
                delay:
                  0.08,

                duration:
                  0.75,

                ease:
                  "easeOut",
              }}
              className="relative overflow-hidden rounded-[24px] border border-white/[0.11] bg-white/[0.055] p-6 shadow-[0_34px_90px_rgba(0,0,0,.20)] backdrop-blur-xl sm:p-7"
            >
              <div
                aria-hidden="true"
                className="absolute -right-24 -top-24 h-[340px] w-[340px] rounded-full border border-white/[0.06]"
              />


              <div className="relative">
                <div className="flex items-start justify-between gap-5">
                  <div className="flex items-center gap-4">
                    <motion.div
                      whileHover={
                        reduceMotion
                          ? undefined
                          : {
                              rotate:
                                -4,

                              scale:
                                1.05,
                            }
                      }
                      className="flex h-16 w-16 shrink-0 items-center justify-center rounded-[16px] border border-white/[0.10] bg-black/10 text-[17px] font-black text-white"
                    >
                      {
                        initials
                      }
                    </motion.div>


                    <div>
                      <p className="text-[7px] font-black uppercase tracking-[0.13em] text-[#718798]">
                        CUSTOMER PROFILE
                      </p>

                      <h2 className="mt-1.5 text-[21px] font-black tracking-[-0.03em] text-white">
                        {
                          fullName
                        }
                      </h2>

                      <p className="mt-1 text-[8px] text-[#8ea2b1]">
                        {
                          user.email
                        }
                      </p>
                    </div>
                  </div>


                  <span className="flex h-10 w-10 items-center justify-center rounded-full border border-[#60ce96]/20 bg-[#60ce96]/10 text-[#6edca4]">
                    <BadgeCheck className="h-4 w-4" />
                  </span>
                </div>


                <div className="mt-7 grid grid-cols-2 gap-2">
                  <HeroMetric
                    label="Orders"
                    value={
                      String(
                        orders.length,
                      )
                    }
                  />

                  <HeroMetric
                    label="Vehicles"
                    value={
                      String(
                        vehicles.length,
                      )
                    }
                  />

                  <HeroMetric
                    label="Saved parts"
                    value={
                      String(
                        wishlist.length,
                      )
                    }
                  />

                  <HeroMetric
                    label="Unread"
                    value={
                      String(
                        unreadCount,
                      )
                    }
                  />
                </div>


                <div className="mt-5 rounded-[12px] border border-white/[0.08] bg-black/10 p-4">
                  <div className="flex items-center justify-between gap-4">
                    <div>
                      <p className="text-[7px] font-black uppercase tracking-[0.11em] text-[#6d8293]">
                        VEHICLE CONTEXT
                      </p>

                      <p className="mt-1.5 text-[9px] font-bold text-[#dbe4eb]">
                        {activeVehicle
                          ? `${activeVehicle.year} ${activeVehicle.make} ${activeVehicle.model}`
                          : "No active vehicle"}
                      </p>
                    </div>


                    <span
                      className={
                        activeVehicle
                          ? "flex h-9 w-9 items-center justify-center rounded-[9px] bg-[#60ce96]/10 text-[#6edca4]"
                          : "flex h-9 w-9 items-center justify-center rounded-[9px] border border-white/[0.08] text-[#718798]"
                      }
                    >
                      <CarFront className="h-4 w-4" />
                    </span>
                  </div>
                </div>
              </div>
            </motion.div>
          </div>
        </div>
      </section>


      {/* ======================================================
          METRICS
      ====================================================== */}

      <section className="border-b border-[#e1e6ea] bg-white">
        <div className="mx-auto grid max-w-[1480px] sm:grid-cols-2 xl:grid-cols-4">
          <OverviewMetric
            icon={
              Package
            }
            label="Total orders"
            value={
              String(
                orders.length,
              )
            }
            detail={`${deliveredOrders} delivered`}
            href="/orders"
          />


          <OverviewMetric
            icon={
              CarFront
            }
            label="Garage vehicles"
            value={
              String(
                vehicles.length,
              )
            }
            detail={
              activeVehicle
                ? "Active context ready"
                : "No active vehicle"
            }
            href="/account/garage"
          />


          <OverviewMetric
            icon={
              Heart
            }
            label="Saved products"
            value={
              String(
                wishlist.length,
              )
            }
            detail="Wishlist products"
            href="/shop"
          />


          <OverviewMetric
            icon={
              Bell
            }
            label="Unread alerts"
            value={
              String(
                unreadCount,
              )
            }
            detail={`${notifications.length} total notifications`}
            href="/account/notifications"
          />
        </div>
      </section>


      {/* ======================================================
          DASHBOARD BODY
      ====================================================== */}

      <section className="mx-auto max-w-[1480px] px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
        {warnings.length >
          0 && (
          <div className="mb-7 rounded-[12px] border border-[#f0ddb0] bg-[#fffaf0] px-5 py-4">
            <p className="text-[8px] font-black uppercase tracking-[0.11em] text-[#8a6116]">
              Partial account data
            </p>

            <p className="mt-1 text-[8px] leading-4 text-[#9a7020]">
              {
                warnings.join(
                  " ",
                )
              }
            </p>
          </div>
        )}


        <div className="grid gap-7 xl:grid-cols-[230px_minmax(0,1fr)]">
          {/* ==================================================
              SIDEBAR
          ================================================== */}

          <AccountSidebar
            initials={
              initials
            }
            name={
              fullName
            }
            email={
              user.email
            }
          />


          {/* ==================================================
              MAIN CONTENT
          ================================================== */}

          <div className="min-w-0 space-y-7">
            {/* HEADING */}

            <div className="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
              <div>
                <p className="text-[8px] font-black uppercase tracking-[0.16em] text-[#e31b2d]">
                  ACCOUNT OVERVIEW
                </p>

                <h2 className="mt-3 text-[34px] font-black tracking-[-0.045em] text-[#101828] sm:text-[44px]">
                  Your Vehnexa activity.
                </h2>

                <p className="mt-3 max-w-[650px] text-[10px] leading-5 text-[#667085]">
                  A live summary of the account
                  data already connected to your
                  customer profile.
                </p>
              </div>


              <button
                type="button"
                disabled={
                  loading
                }
                onClick={() => {
                  void loadOverview();
                }}
                className="inline-flex h-10 self-start items-center gap-2 rounded-[8px] border border-[#d6dce2] bg-white px-4 text-[8px] font-bold text-[#475467] transition hover:bg-[#fafbfc] disabled:opacity-50 lg:self-auto"
              >
                {loading && (
                  <Loader2 className="h-3.5 w-3.5 animate-spin" />
                )}

                Refresh overview
              </button>
            </div>


            {/* QUICK ACTIONS */}

            <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
              <QuickAction
                icon={
                  ShoppingBag
                }
                title="Shop parts"
                description="Explore the marketplace."
                href="/shop"
              />

              <QuickAction
                icon={
                  CarFront
                }
                title="Manage Garage"
                description="Change vehicle context."
                href="/account/garage"
              />

              <QuickAction
                icon={
                  Package
                }
                title="Track orders"
                description="Open order history."
                href="/orders"
              />

              <QuickAction
                icon={
                  Bell
                }
                title="Notifications"
                description="See account alerts."
                href="/account/notifications"
              />
            </div>


            {/* RECENT ORDERS + ACTIVE VEHICLE */}

            <div className="grid gap-7 lg:grid-cols-[1.15fr_0.85fr]">
              <DashboardPanel
                eyebrow="ORDER ACTIVITY"
                title="Recent orders"
                actionLabel="View all orders"
                actionHref="/orders"
              >
                {recentOrders.length ===
                0 ? (
                  <EmptyOrders />
                ) : (
                  <div className="divide-y divide-[#edf0f2]">
                    {recentOrders.map(
                      (
                        order,
                      ) => (
                        <RecentOrderRow
                          key={
                            order.id
                          }
                          order={
                            order
                          }
                        />
                      ),
                    )}
                  </div>
                )}
              </DashboardPanel>


              <DashboardPanel
                eyebrow="GARAGE CONTEXT"
                title="Active vehicle"
                actionLabel="Open Garage"
                actionHref="/account/garage"
              >
                <ActiveVehicleCard
                  vehicle={
                    activeVehicle
                  }
                />
              </DashboardPanel>
            </div>


            {/* LOWER DATA */}

            <div className="grid gap-7 lg:grid-cols-3">
              <AddressSummary
                address={
                  defaultAddress
                }
                count={
                  addresses.length
                }
              />


              <WishlistSummary
                count={
                  wishlist.length
                }
              />


              <NotificationSummary
                notifications={
                  notifications
                }
                unreadCount={
                  unreadCount
                }
              />
            </div>


            {/* FINAL CTA */}

            <div className="relative overflow-hidden rounded-[22px] bg-[#071b2d] p-7 text-white shadow-[0_24px_70px_rgba(7,27,45,.14)] sm:p-9">
              <div
                aria-hidden="true"
                className="absolute -right-[120px] -top-[170px] h-[430px] w-[430px] rounded-full bg-[#e31b2d]/15 blur-[100px]"
              />


              <div className="relative flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between">
                <div>
                  <p className="text-[7px] font-black uppercase tracking-[0.15em] text-[#ff5b68]">
                    KEEP YOUR JOURNEY MOVING
                  </p>

                  <h3 className="mt-2 text-[28px] font-black tracking-[-0.04em] sm:text-[34px]">
                    Your account is the bridge
                    between vehicle and marketplace.
                  </h3>

                  <p className="mt-3 max-w-[680px] text-[9px] leading-5 text-[#9fb0bd]">
                    Keep your Garage current,
                    explore compatible parts and
                    return here whenever you need
                    a clear view of your customer
                    activity.
                  </p>
                </div>


                <Link
                  href="/shop"
                  className="group inline-flex h-11 shrink-0 items-center gap-2 self-start rounded-[8px] bg-[#e31b2d] px-5 text-[8px] font-black text-white transition hover:bg-[#c91625] lg:self-auto"
                >
                  Explore marketplace

                  <ArrowRight className="h-3.5 w-3.5 transition group-hover:translate-x-1" />
                </Link>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  );
}


