/* ============================================================
   RECENT ORDER
============================================================ */

function RecentOrderRow({
  order,
}: {
  order:
    Orders[number];
}) {
  return (
    <Link
      href={`/orders/${order.id}`}
      className="group flex items-center gap-4 px-5 py-4 transition hover:bg-[#fafbfc]"
    >
      <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-[9px] border border-[#e1e5e9] bg-[#f6f8fa] text-[#667085] transition group-hover:border-[#efc8cc] group-hover:bg-[#fff0f1] group-hover:text-[#e31b2d]">
        <Package className="h-4 w-4" />
      </span>


      <div className="min-w-0 flex-1">
        <div className="flex flex-wrap items-center gap-2">
          <p className="text-[9px] font-black text-[#101828]">
            #
            {
              order.order_number
            }
          </p>

          <OrderStatus
            status={
              order.status
            }
          />
        </div>

        <p className="mt-1 text-[7px] text-[#98a2b3]">
          {formatDate(
            order.created_at,
          )}

          {" • "}

          {order.items.length}{" "}
          {
            order.items.length ===
            1
              ? "item"
              : "items"
          }
        </p>
      </div>


      <div className="text-right">
        <p className="text-[10px] font-black text-[#101828]">
          {formatCurrency(
            order.total,
          )}
        </p>

        <ChevronRight className="ml-auto mt-1 h-3.5 w-3.5 text-[#c0c7ce] transition group-hover:translate-x-1 group-hover:text-[#e31b2d]" />
      </div>
    </Link>
  );
}


/* ============================================================
   ORDER STATUS
============================================================ */

function OrderStatus({
  status,
}: {
  status:
    string;
}) {
  const normalized =
    status.toLowerCase();


  const className =
    normalized ===
      "delivered"
      ? "border-[#b7e4c8] bg-[#ecfdf3] text-[#16804a]"
      : normalized ===
          "cancelled"
        ? "border-[#f3c4c8] bg-[#fff1f2] text-[#c92a37]"
        : normalized ===
            "shipped"
          ? "border-[#c7dcf0] bg-[#eff6fc] text-[#346aa5]"
          : "border-[#ead9ad] bg-[#fffaeb] text-[#9b6b11]";


  return (
    <span
      className={`rounded-full border px-2 py-0.5 text-[6px] font-black uppercase tracking-[0.07em] ${className}`}
    >
      {formatLabel(
        status,
      )}
    </span>
  );
}


/* ============================================================
   EMPTY ORDERS
============================================================ */

function EmptyOrders() {
  return (
    <div className="flex min-h-[250px] items-center justify-center p-7">
      <div className="max-w-[350px] text-center">
        <span className="mx-auto flex h-14 w-14 items-center justify-center rounded-[14px] bg-[#f4f6f8] text-[#98a2b3]">
          <Package className="h-5 w-5" />
        </span>

        <h4 className="mt-4 text-[14px] font-black text-[#101828]">
          No orders yet
        </h4>

        <p className="mt-2 text-[8px] leading-4 text-[#7b8794]">
          Your latest purchases and their
          statuses will appear here.
        </p>

        <Link
          href="/shop"
          className="mt-5 inline-flex h-9 items-center gap-2 rounded-[7px] bg-[#e31b2d] px-4 text-[7px] font-black text-white"
        >
          Browse parts

          <ArrowRight className="h-3 w-3" />
        </Link>
      </div>
    </div>
  );
}


/* ============================================================
   ACTIVE VEHICLE
============================================================ */

function ActiveVehicleCard({
  vehicle,
}: {
  vehicle:
    Vehicles[number] |
    null;
}) {
  if (!vehicle) {
    return (
      <div className="flex min-h-[250px] items-center justify-center p-7">
        <div className="max-w-[330px] text-center">
          <span className="mx-auto flex h-14 w-14 items-center justify-center rounded-[14px] bg-[#071b2d] text-white">
            <CarFront className="h-5 w-5" />
          </span>

          <h4 className="mt-4 text-[14px] font-black text-[#101828]">
            No active vehicle
          </h4>

          <p className="mt-2 text-[8px] leading-4 text-[#7b8794]">
            Add or activate a vehicle to make
            compatibility context available.
          </p>

          <Link
            href="/account/garage"
            className="mt-5 inline-flex h-9 items-center gap-2 rounded-[7px] bg-[#071b2d] px-4 text-[7px] font-black text-white"
          >
            Open Garage

            <ArrowRight className="h-3 w-3" />
          </Link>
        </div>
      </div>
    );
  }


  return (
    <div className="relative min-h-[250px] overflow-hidden p-5">
      <div
        aria-hidden="true"
        className="absolute -right-20 -top-20 h-60 w-60 rounded-full bg-[#e31b2d]/[0.05] blur-[55px]"
      />


      <div className="relative">
        <div className="flex items-center justify-between gap-4">
          <span className="inline-flex items-center gap-1.5 rounded-full border border-[#b7e4c8] bg-[#ecfdf3] px-2.5 py-1 text-[6px] font-black text-[#16804a]">
            <CheckCircle2 className="h-3 w-3" />

            ACTIVE
          </span>

          <CircleGauge className="h-4 w-4 text-[#98a2b3]" />
        </div>


        <div className="mt-5 flex h-[105px] items-center justify-center overflow-hidden rounded-[12px] border border-[#edf0f2] bg-[#f8fafb]">
          {vehicle.image_url ? (
            /* eslint-disable-next-line @next/next/no-img-element */
            <img
              src={
                vehicle.image_url
              }
              alt={`${vehicle.year} ${vehicle.make} ${vehicle.model}`}
              className="h-full w-full object-contain p-3"
            />
          ) : (
            <CarFront className="h-10 w-10 text-[#c0c8d0]" />
          )}
        </div>


        <h4 className="mt-4 text-[15px] font-black tracking-[-0.025em] text-[#101828]">
          {vehicle.year}{" "}
          {vehicle.make}{" "}
          {vehicle.model}
        </h4>

        <p className="mt-1 text-[8px] font-semibold text-[#7b8794]">
          {
            vehicle.engine
          }

          {" • "}

          {
            vehicle.transmission
          }
        </p>
      </div>
    </div>
  );
}


/* ============================================================
   ADDRESS SUMMARY
============================================================ */

function AddressSummary({
  address,
  count,
}: {
  address:
    Addresses[number] |
    null;

  count:
    number;
}) {
  return (
    <SummaryCard
      icon={
        MapPin
      }
      eyebrow="DELIVERY"
      title="Saved addresses"
      actionHref="/account/addresses"
      actionLabel="Manage"
    >
      {address ? (
        <>
          <p className="text-[13px] font-black text-[#101828]">
            {
              address.label
            }
          </p>

          <p className="mt-2 line-clamp-2 text-[8px] leading-4 text-[#667085]">
            {
              address.address_line1
            }

            {", "}

            {
              address.city
            }
          </p>

          <div className="mt-4 flex items-center gap-2 text-[7px] font-bold text-[#16804a]">
            {address.is_default && (
              <BadgeCheck className="h-3.5 w-3.5" />
            )}

            {
              count
            }{" "}
            saved{" "}
            {
              count ===
              1
                ? "address"
                : "addresses"
            }
          </div>
        </>
      ) : (
        <EmptySummary
          text="No saved delivery addresses yet."
        />
      )}
    </SummaryCard>
  );
}


/* ============================================================
   WISHLIST SUMMARY
============================================================ */

function WishlistSummary({
  count,
}: {
  count:
    number;
}) {
  return (
    <SummaryCard
      icon={
        Heart
      }
      eyebrow="SAVED PARTS"
      title="Wishlist"
      actionHref="/shop"
      actionLabel="Browse"
    >
      <p className="text-[34px] font-black tracking-[-0.045em] text-[#101828]">
        {
          count
        }
      </p>

      <p className="mt-2 text-[8px] leading-4 text-[#667085]">
        {count ===
        0
          ? "Products you save while exploring the marketplace will be counted here."
          : `${count} ${
              count ===
              1
                ? "product is"
                : "products are"
            } currently saved to your wishlist.`}
      </p>
    </SummaryCard>
  );
}


/* ============================================================
   NOTIFICATION SUMMARY
============================================================ */

function NotificationSummary({
  notifications,
  unreadCount,
}: {
  notifications:
    Notifications;

  unreadCount:
    number;
}) {
  const latest =
    [
      ...notifications,
    ].sort(
      (
        a,
        b,
      ) =>
        new Date(
          b.created_at,
        ).getTime() -
        new Date(
          a.created_at,
        ).getTime(),
    )[0] ??
    null;


  return (
    <SummaryCard
      icon={
        Bell
      }
      eyebrow="INBOX"
      title="Notifications"
      actionHref="/account/notifications"
      actionLabel="Open inbox"
    >
      <p className="text-[34px] font-black tracking-[-0.045em] text-[#101828]">
        {
          unreadCount
        }
      </p>

      <p className="mt-1 text-[7px] font-bold uppercase tracking-[0.08em] text-[#98a2b3]">
        Unread
      </p>


      {latest ? (
        <div className="mt-4 rounded-[9px] bg-[#f7f8fa] p-3">
          <p className="line-clamp-1 text-[8px] font-black text-[#344054]">
            {
              latest.title
            }
          </p>

          <p className="mt-1 line-clamp-2 text-[7px] leading-4 text-[#7b8794]">
            {
              latest.message
            }
          </p>
        </div>
      ) : (
        <p className="mt-4 text-[8px] leading-4 text-[#667085]">
          No account notifications yet.
        </p>
      )}
    </SummaryCard>
  );
}


