            }
      }
      className="min-h-[245px] rounded-[17px] border border-[#dce2e7] bg-white p-5 shadow-[0_10px_32px_rgba(15,23,42,.035)]"
    >
      <div className="flex items-center justify-between">
        <span className="flex h-10 w-10 items-center justify-center rounded-[9px] bg-[#f3f5f7] text-[#596b7a]">
          <Icon className="h-4 w-4" />
        </span>

        <Link
          href={
            actionHref
          }
          className="text-[7px] font-black text-[#98a2b3] transition hover:text-[#e31b2d]"
        >
          {
            actionLabel
          }
        </Link>
      </div>


      <p className="mt-5 text-[7px] font-black uppercase tracking-[0.13em] text-[#e31b2d]">
        {
          eyebrow
        }
      </p>

      <h3 className="mt-1 text-[12px] font-black text-[#101828]">
        {
          title
        }
      </h3>


      <div className="mt-5">
        {
          children
        }
      </div>
    </motion.section>
  );
}


